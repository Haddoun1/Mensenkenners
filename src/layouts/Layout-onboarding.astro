---
// @ts-nocheck
import { ClientRouter } from "astro:transitions";

const bounceTransition = {
  forwards: {
    old: {
      name: "bounceOut",
      duration: "0.3s",
      easing: "ease-in",
      fillMode: "forwards",
    },
    new: {
      name: "bounceIn",
      duration: "0.4s",
      easing: "cubic-bezier(0.34, 1.3, 0.64, 1)",
      fillMode: "backwards",
      delay: "0.3s",
    },
  },
  backwards: {
    old: {
      name: "bounceOutRight",
      duration: "0.3s",
      easing: "ease-in",
      fillMode: "forwards",
    },
    new: {
      name: "bounceInLeft",
      duration: "0.4s",
      easing: "cubic-bezier(0.34, 1.3, 0.64, 1)",
      fillMode: "backwards",
      delay: "0.3s",
    },
  },
};

const {
  title,
  nextHref = "/",
  backHref = "/",
  headingText = "Welkom!",
  bodyText = "...",
  step = 1,
  totalSteps = 5,
  stepId,
  category,
  showBack = true,
  showProgress = true,
  showNext = true,
  mockupSrc = "",
  variant = "",
  showDashboardButton = true,
} = Astro.props;

// https://claude.ai/chat/8789b362-5b69-4d5c-9b16-a4b157d09820 button back niet op welkompagina, wel op rest van stappen
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/onboarding.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <ClientRouter />
    <script is:inline>
    if (localStorage.getItem("theme") === "dark") {
    document.documentElement.classList.add("dark-mode");
  }
</script>
  </head>

  <body>
    <main class={`container ${variant}`}     
    data-step-id={stepId}
    data-category={category} 
    >
    <div class="wrapper-dashboardBtn">
  {showDashboardButton && (
    <div class="wrapper-dashboardBtn">
      <a href="/index.html" class="back-button">
        Dashboard
      </a>
    </div>
  )}
    </div>
      <div class="logo-mobile">
        <img
          src="/images/Mensenkenners-logo-hori.png"
          alt="Mensenkenners logo"
        />
      </div>

      <div class="content" transition:animate="none" transition:name="content">
        <!-- Links op desktop: slot voor bv. een afbeelding of illustratie -->
        <div class="panel-left">
          <slot />
        </div>

        <!-- Rechts op desktop: logo, tekst, progress, knoppen -->
        <div class="panel-right">
          {mockupSrc && <img class="mockup" src={mockupSrc} alt="mockup" />}
          <div class="logo-desktop">
            <img
              src="/images/Mensenkenners-logo-hori.png"
              alt="Mensenkenners logo"
            />
          </div>

          <div class="text-section">
            {
              showProgress && (
                <div class="progress-bar">
                  {Array.from({ length: totalSteps }, (_, i) => (
                    <div
                      class={`progress ${i < step - 1 ? "done-small" : ""} ${i === step - 1 ? "done" : ""}`}
                    />
                  ))}
                </div>
              )
            }

            <div class="question-wrapper">
              <slot name="question" />
            </div>

            <div class="questionnaire">
              <h1>{headingText}</h1>
              <p>{bodyText}</p>
            </div>
          </div>

          <div class="buttons-onboarding">
            {
              showNext && (
                <a class="button-next" href={nextHref} data-direction="forward">
                  <button>Ga verder</button>
                </a>
              )
            }
            {
              showBack && (
                <a
                  class="button-back"
                  href={backHref}
                  id="back-btn"
                  data-direction="back"
                >
                  <button>Ga terug</button>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </main>
  </body>
</html>

