---
// @ts-nocheck
import { ClientRouter } from "astro:transitions";
import BaseHead from '../components/BaseHead.astro';
import FixedThemeToggle from '../components/FixedThemeToggle.astro';
import OnboardingImage from '../components/OnboardingImage.astro';
import ThemeLogo from '../components/ThemeLogo.astro';


const bounceTransition = {
  forwards: {
    old: {
      name: "bounceOut",
      duration: "0.3s",
      easing: "ease-in",
      fillMode: "forwards",
    },
    new: {
      name: "bounceIn",
      duration: "0.4s",
      easing: "cubic-bezier(0.34, 1.3, 0.64, 1)",
      fillMode: "backwards",
      delay: "0.3s",
    },
  },
  backwards: {
    old: {
      name: "bounceOutRight",
      duration: "0.3s",
      easing: "ease-in",
      fillMode: "forwards",
    },
    new: {
      name: "bounceInLeft",
      duration: "0.4s",
      easing: "cubic-bezier(0.34, 1.3, 0.64, 1)",
      fillMode: "backwards",
      delay: "0.3s",
    },
  },
};

const {
  title,
  nextHref = "/",
  backHref = "/",
  headingText = "Welkom!",
  bodyText = "...",
  step = 1,
  totalSteps = 5,
  stepId,
  category,
  showBack = true,
  showProgress = true,
  showNext = true,
  mockupSrc = "",
  mockupAlt = "",
  variant = "",
  showDashboardButton = true,
  hasQuestion = null,
  nextLabel = "Ga verder",
  requireLogin = false,
} = Astro.props;

// https://claude.ai/chat/8789b362-5b69-4d5c-9b16-a4b157d09820 button back niet op welkompagina, wel op rest van stappen
---

<html lang="nl">
  <head>
    <!-- BaseHead zet charset, viewport, title, global.css, favicon en het dark-mode script. -->
    <BaseHead title={title} />
    <link rel="stylesheet" href="/styles/onboarding.css" />
    <ClientRouter />
  </head>

  <body>
    <FixedThemeToggle />
    <main
      class={`container ${variant}`}
      data-step-id={stepId}
      data-category={category}
    >
      <div class="wrapper-dashboardBtn">
        {
          showDashboardButton && (
            <div class="wrapper-dashboardBtn">
              <a href="/" class="back-button">
                Dashboard
              </a>
            </div>
          )
        }
      </div>
      <div class="logo-mobile">
        <div>
          <ThemeLogo class="logo-image" />
        </div>
      </div>

      <div class="content">
        <!-- Links op desktop: slot voor bv. een afbeelding of illustratie -->
        <div
          class="panel-left"
          transition:name="panel-left"
          transition:animate="none"
        >
          <slot />
        </div>

        <!-- Rechts op desktop: logo, tekst, progress, knoppen -->
        <div class="panel-right">
          {mockupSrc && <OnboardingImage class="mockup" src={mockupSrc} alt={mockupAlt} transition:name="mockup" />}
          <div class="logo-desktop">
                <div>
          <ThemeLogo class="logo-image" />
        </div>
          </div>

          <div
            class="text-section"
            transition:animate="none"
            transition:name={(hasQuestion ?? Astro.slots.has("question")) ? "content-quiz" : "content"}
          >
            {
              showProgress && (
                <div class="progress-bar">
                  {Array.from({ length: totalSteps }, (_, i) => (
                    <div
                      class={`progress ${i < step - 1 ? "done-small" : ""} ${i === step - 1 ? "done" : ""}`}
                    />
                  ))}
                </div>
              )
            }

            {
              (hasQuestion ?? Astro.slots.has("question")) && (
                <div class="question-wrapper">
                  <slot name="question" />
                </div>
              )
            }
            <div class="questionnaire">
              <h1>{headingText}</h1>
              <p>{bodyText}</p>
            </div>
          </div>

          <!-- Links die eruitzien als knop. Geen <button> in de <a>: dat is ongeldige HTML en geeft
               toetsenbordgebruikers twee tabstops voor één knop. De span krijgt de knopstijl (onboarding.css). -->
          <div class="buttons-onboarding">
            {
              showNext && (
                <a class="button-next" href={nextHref} data-direction="forward" data-require-login={requireLogin ? "true" : undefined}>
                  <span class="onboarding-btn">{nextLabel}</span>
                </a>
              )
            }
            {
              showBack && (
                <a
                  class="button-back"
                  href={backHref}
                  id="back-btn"
                  data-direction="back"
                >
                  <span class="onboarding-btn">Ga terug</span>
                </a>
              )
            }
          </div>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  .logo-image {
    height: 40px;
    width: 160px;
    object-fit: contain;
    object-position: left;
  }

  .logo-mobile .logo-image{
    transform: scale(1.8);
  }
</style>

<!-- https://claude.ai/chat/c67f7248-9580-489f-a97f-bb6489468314 het terugnavigeren met view transitions voor de backbuttons -->
<script>
  // @ts-nocheck
  import { navigate } from "astro:transitions/client";
  import { supabase, authHeaders } from "../lib/supabase";

  let goingBack = false;
  let controller = new AbortController();

  document.addEventListener("astro:before-preparation", (e) => {
    document.documentElement.classList.toggle("is-going-back", goingBack);

    // Onthoud waar je vandaan kwam: bij view transitions wordt document.referrer niet bijgewerkt.
    // login.astro gebruikt dit voor de "Ga terug"-knop.
    try {
      sessionStorage.setItem(
        "onboardingPreviousPage",
        JSON.stringify({ from: e.from.pathname + e.from.search, to: e.to.pathname + e.to.search }),
      );
    } catch {
      // sessionStorage niet beschikbaar: login valt terug op document.referrer.
    }
  });

  async function setupTracking() {
    const main = document.querySelector("main");
    const stepId = main?.dataset.stepId;
    const category = main?.dataset.category;
    const startedAt = Date.now();

    const {
      data: { user },
    } = await supabase.auth.getUser();

    async function saveProgress() {
      if (!stepId || !category) {
        console.warn("stepId of category ontbreekt", { stepId, category });
        return;
      }

      const endedAt = Date.now();
      const step = {
        stepId,
        category,
        currentUrl: window.location.pathname,
        startedAt: new Date(startedAt).toISOString(),
        endedAt: new Date(endedAt).toISOString(),
        durationSeconds: Math.round((endedAt - startedAt) / 1000),
      };

      // Nog niet ingelogd: de onboarding komt vóór de login. Bewaar de stap
      // lokaal; login.astro slaat hem op zodra de gebruiker is ingelogd.
      if (!user?.id) {
        try {
          const pending = JSON.parse(
            localStorage.getItem("pendingOnboardingProgress") || "[]",
          ).filter((s) => s.stepId !== stepId);
          pending.push(step);
          localStorage.setItem("pendingOnboardingProgress", JSON.stringify(pending));
        } catch {
          // localStorage niet beschikbaar: voortgang wordt niet bewaard.
        }
        return;
      }

      await fetch("/api/track-step", {
        method: "POST",
        headers: await authHeaders(),
        keepalive: true,
        body: JSON.stringify(step),
      });
    }

    return { saveProgress, user };
  }

  // Antwoorden op de onboardingvragen bewaren, net als bij de modules: in de tabel course_answers
  // (categorie "onboarding", vraag-id = name van de vraag). Nog niet ingelogd? Dan lokaal bewaren;
  // login.astro slaat ze op zodra de gebruiker is ingelogd.
  async function setupAnswers(user) {
    const inputs = [...document.querySelectorAll('main .question input[type="radio"], main .question input[type="checkbox"]')];
    const questionId = inputs[0]?.name;
    if (!questionId) return;

    const isMulti = inputs[0].type === "checkbox";
    const readAnswer = () => {
      const chosen = inputs.filter((input) => input.checked).map((input) => input.value);
      return isMulti ? { choices: chosen } : { choice: chosen[0] ?? null };
    };

    // Eerder gegeven antwoord terugzetten.
    let saved = null;
    if (user?.id) {
      const { data, error } = await supabase
        .from("course_answers")
        .select("answer")
        .eq("user_id", user.id)
        .eq("category", "onboarding")
        .eq("question_id", questionId)
        .maybeSingle();
      if (error) console.error("Antwoord ophalen mislukt:", error.message);
      saved = data?.answer;
    } else {
      try {
        saved = JSON.parse(localStorage.getItem("pendingOnboardingAnswers") || "{}")[questionId];
      } catch {}
    }

    if (saved) {
      const chosen = isMulti ? saved.choices ?? [] : [saved.choice];
      inputs.forEach((input) => (input.checked = chosen.includes(input.value)));
      // Bevestigingstekst (QuestionSingle) ook tonen als er al een antwoord stond.
      const confirmation = document.querySelector("main .confirmation-text");
      if (confirmation && inputs.some((input) => input.checked)) confirmation.hidden = false;
    }

    // Elke keuze direct opslaan.
    const save = async () => {
      const answer = readAnswer();

      if (!user?.id) {
        try {
          const pending = JSON.parse(localStorage.getItem("pendingOnboardingAnswers") || "{}");
          pending[questionId] = answer;
          localStorage.setItem("pendingOnboardingAnswers", JSON.stringify(pending));
        } catch {
          // localStorage niet beschikbaar: antwoord wordt niet bewaard.
        }
        return;
      }

      const { error } = await supabase.from("course_answers").upsert(
        {
          user_id: user.id,
          category: "onboarding",
          question_id: questionId,
          answer,
          updated_at: new Date().toISOString(),
        },
        { onConflict: "user_id,category,question_id" },
      );
      if (error) console.error("Antwoord opslaan mislukt:", error.message);
    };

    inputs.forEach((input) => input.addEventListener("change", save));
  }

  async function setupNavigation() {
    controller.abort();
    controller = new AbortController();
    const signal = controller.signal;

    const { saveProgress, user } = await setupTracking();
    await setupAnswers(user);

    const backBtn = document.getElementById("back-btn");
    const nextBtn = document.querySelector(".button-next");

    // Stap met requireLogin: wie nog niet is ingelogd, gaat eerst naar de login
    // en komt daarna terug bij de volgende stap. Ingelogde gebruikers gaan direct door.
    if (nextBtn && !user && nextBtn.dataset.requireLogin === "true") {
      const afterLogin = nextBtn.getAttribute("href") ?? "/";
      nextBtn.setAttribute("href", `/onboarding/login?next=${encodeURIComponent(afterLogin)}`);
    }

    // Laatste onboardingstap: wie nog niet is ingelogd, gaat eerst naar de login.
    if (nextBtn && !user && nextBtn.getAttribute("href") === "/") {
      nextBtn.setAttribute("href", "/onboarding/login");
      const label = nextBtn.querySelector(".onboarding-btn");
      if (label) label.textContent = "Log in om verder te gaan";
    }

    if (backBtn) {
      backBtn.addEventListener(
        "click",
        (e) => {
          e.preventDefault();
          goingBack = true;
          navigate(backBtn.getAttribute("href") ?? "/");
        },
        { signal },
      );
    }

    if (nextBtn) {
      nextBtn.addEventListener(
        "click",
        async (e) => {
          e.preventDefault();
          goingBack = false;

          await saveProgress();

          navigate(nextBtn.getAttribute("href") ?? "/");
        },
        { signal },
      );
    }
  }

  document.addEventListener("astro:page-load", setupNavigation);

  document.addEventListener("astro:after-swap", () => {
    document.documentElement.classList.toggle("is-going-back", goingBack);
    goingBack = false;

    if (localStorage.getItem("theme") === "dark") {
      document.documentElement.classList.add("dark-mode");
    }
  });
</script>

