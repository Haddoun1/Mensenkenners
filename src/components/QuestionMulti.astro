---
const { question, options, name } = Astro.props;

// @ts-nocheck
---
<div class="question">
  <p>{question}</p>

  <div class="questions-multiple">
    {options.map(opt => (
        <label>
        <input type="checkbox" name={name} value={opt} />
        {opt}
        </label>
    ))}
  </div>
</div>

<style>
  :global(.panel-right) {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    min-width: 0;
  }

  :global(.text-section) {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--size-2xl) !important;
  }

  :global(.question-wrapper) {
    flex: 1;
    display: flex;
    width: 100%;
  }

  .question {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    height: 100%;
  }

  .questions-multiple {
    flex: 1;
    width: 100%;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--size-base);
  }

  .questions-multiple label {
    padding: 0.6em;
    font-size: var(--size-sm);
    border: 1px solid var(--color-text-muted);
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    flex-direction: row;
    color: var(--color-text-muted);
    transition: 0.5s;
    text-align: center;
    height: 100%;
    align-items: center;
    justify-content: center;

    font-family: var(--font-medium);

    &:has(input[type="checkbox"]:checked) {
      background-color: var(--color-cyan-dark);
      border-color: var(--color-cyan-dark);
      color: white;
      font-family: var(--font-bold);
    }

    &:hover {
      background-color: rgb(139 202 178 / 0.5);
      border-color: var(--color-cyan-dark);
    }
  }

  .questions-multiple input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
</style>