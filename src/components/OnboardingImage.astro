---
// @ts-nocheck
import { Image, getImage } from "astro:assets";

// Zoekt een afbeelding uit src/assets/images op bestandsnaam. Zo kunnen pagina's en
// onboarding-steps.json gewoon een pad als "/images/x.webp" gebruiken, terwijl Astro's
// <Image /> de afbeelding verkleint en optimaliseert.
const images = import.meta.glob("../assets/images/*.{webp,png,jpg,jpeg}", { eager: true });

// animated: voor een bewegende WebP. Verkleind naar 400px scheelt veel, maar op volle breedte
// maakt Astro hem groter dan het origineel. Daarom: kleine versie voor smalle schermen, het
// originele bestand (uit public/) voor brede. <Image /> kan het origineel niet in de srcset zetten, vandaar <img>.
const { src, alt = "", class: className = "mockup", animated = false, ...rest } = Astro.props;

const fileName = src?.split("/").pop();
const match = Object.entries(images).find(([path]) => path.endsWith(`/${fileName}`));
const asset = match?.[1].default;
const small = animated && asset ? await getImage({ src: asset, width: 400, format: "webp" }) : null;
---

{
  small ? (
    <img
      src={src}
      srcset={`${small.src} 400w, ${src} ${asset.width}w`}
      sizes="(min-width: 768px) 400px, 90vw"
      width={asset.width}
      height={asset.height}
      alt={alt}
      class={className}
      loading="eager"
      decoding="async"
      {...rest}
    />
  ) : asset ? (
    <Image
      src={asset}
      alt={alt}
      class={className}
      widths={[400, 800]}
      sizes="(min-width: 768px) 400px, 90vw"
      loading="eager"
      {...rest}
    />
  ) : (
    // Staat de afbeelding (nog) niet in src/assets/images, dan gewoon de oude <img>.
    src && <img src={src} alt={alt} class={className} {...rest} />
  )
}
