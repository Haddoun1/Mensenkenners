---
import ThemeToggle from "../components/ThemeToggle.astro";
---

<header>
  <div>
      <a href="/" class="logo">
    <img
      class="logo-image logo-image--light"
      src="/images/logohorizontaal.png"
      alt="Stichting Mensenkenners logo"
    />
    <img
      class="logo-image logo-image--dark"
      src="/images/mensenkennerslogowit.png"
      alt="Stichting Mensenkenners logo"
    />
  </a>
  </div>

  <button class="hamburger">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav>
    <a
      href="https://www.stichtingmensenkenners.nl/"
      target="_blank"
      rel="noopener noreferrer">Over Stichting Mensenkenners</a
    >
    <a
      href="https://www.amsterdam.nl/iedereen-doet-mee/"
      target="_blank"
      rel="noopener noreferrer">Meer Acties van Gemeente Amsterdam</a
    >
    <a
      href="https://www.ink.team/projects/mensenkenners"
      target="_blank"
      rel="noopener noreferrer">Contact</a
    >
    <a href="/profile" class="profile-link" id="profile-nav-link">Mijn Profiel</a>
    <ThemeToggle />
  </nav>
</header>

<style>
  body {
    margin: 0;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 999;
    background: var(--gradient-bg-header);
    backdrop-filter: blur(5px);
  }
  nav {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
    font-family: "Plus Jakarta Sans Bold";
    transition: all 0.3s ease;
    border-bottom: 2px solid transparent;
    padding: var(--size-xs) 0;
  }

  nav a:hover {
    border-bottom: 2px solid;
  }

  /* Hamburger button Dicht */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 22px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 10;
  }

  .hamburger span {
    display: block;
    height: 3px;
    width: 100%;
    background-color: var(--color-text);
    border-radius: 2px;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  /* Open */
  .hamburger.open span:nth-child(1) {
    transform: translateY(9.5px) rotate(45deg);
  }
  .hamburger.open span:nth-child(2) {
    opacity: 0;
  }
  .hamburger.open span:nth-child(3) {
    transform: translateY(-9.5px) rotate(-45deg);
  }

  /* Mobile styles */
  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }

    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background-color: var(--color-cyan);
      padding: 1rem 2rem;
      text-align: center;

      border-bottom: 1px solid transparent;
    }

    nav.open {
      display: flex;
    }

    nav a {
      padding: 0.75rem 0;
      /* border-bottom: 1px solid rgba(0, 0, 0, 0.08); */
    }

    nav a:last-child {
      border-bottom: none;
    }
  }

  .logo-image {
    height: 40px;
    width: 160px;
    object-fit: contain;
    object-position: left;
  }

  .logo-image--dark {
    display: none;
  }

  :global(html.dark-mode) .logo-image--light {
    display: none;
  }

  :global(html.dark-mode) .logo-image--dark {
    display: block;
  }
</style>

<script>
  import { supabase } from "../lib/supabase";

  const hamburger = document.querySelector(".hamburger");
  const nav = document.querySelector("nav");

  hamburger?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("open");
    hamburger.classList.toggle("open");
    hamburger.setAttribute("aria-expanded", String(isOpen));
  });

  // Toont "Inloggen" i.p.v. "Mijn Profiel" zolang niemand is ingelogd.
  const profileLink = document.getElementById("profile-nav-link");

  if (profileLink) {
    const {
      data: { user },
    } = await supabase.auth.getUser();

    if (!user) {
      profileLink.textContent = "Inloggen";
      profileLink.setAttribute("href", "/onboarding/login");
    }
  }
</script>
