---
// @ts-nocheck
const { question, options, name, confirmation } = Astro.props;
---

<div class="question" data-confirmation={confirmation ? "true" : "false"}>
  <div class="questions-single">
    {
      options.map((opt) => (
        <label>
          <input type="radio" name={name} value={opt} />
          {opt}
        </label>
      ))
    }
  </div>
  {confirmation && <p class="confirmation-text" hidden>{confirmation}</p>}
</div>

<style>
  :global(.panel-right:has(.question-wrapper)) {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    min-width: 0;
  }

  :global(.text-section:has(.question-wrapper)) {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--size-2xl) !important;
  }

  :global(.question-wrapper) {
    flex: 1;
    display: flex;
    width: 100%;
  }

  .question {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    height: 100%;
  }

  .questions-single {
    flex: 1;
    width: 100%;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--size-base);
  }

  .questions-single label {
    padding: 0.6em;
    font-size: var(--size-sm);
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    flex-direction: row;
    
    border: 1px solid var(--onboarding-label);
    color: var(--onboarding-label);
    
    transition: 0.5s;
    text-align: center;
    height: 100%;
    align-items: center;
    justify-content: center;

    font-family: var(--font-medium);

    &:has(input[type="radio"]:checked) {
      background-color: var(--color-cyan-dark);
      border-color: var(--color-cyan-dark);
      color: white;
      font-family: var(--font-bold);
    }

    &:hover {
      background-color: rgb(139 202 178 / 0.5);
      border-color: var(--color-cyan-dark);
    }
  }

  .questions-single input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .confirmation-text {
    margin: var(--size-base) 0 0;
    padding: 0.8em 1em;
    border-radius: 8px;
    background-color: rgb(139 202 178 / 0.15);
    border: 1px solid var(--color-cyan-dark);
    color: var(--onboarding-label);
    font-family: var(--font-medium);
    font-size: var(--size-sm);
    text-align: center;
  }

  @media (min-width: 1200px) {
    .questions-single label {
      font-size: var(--size-lg);
    }
  }
</style>

<script>
  // @ts-nocheck
  function setupConfirmation() {
    document
      .querySelectorAll('.question[data-confirmation="true"]')
      .forEach((question) => {
        const confirmationEl = question.querySelector(".confirmation-text");
        if (!confirmationEl) return;

        question
          .querySelectorAll('input[type="radio"]')
          .forEach((input) => {
            input.addEventListener("change", () => {
              confirmationEl.hidden = false;
            });
          });
      });
  }

  document.addEventListener("astro:page-load", setupConfirmation);
</script>
