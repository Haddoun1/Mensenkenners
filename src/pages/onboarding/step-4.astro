---
export const prerender = false;
import MainLayout from "../../layouts/Layout-onboarding.astro";
import { getImage } from "astro:assets";
import simulatorAnimation from "../../assets/images/mensenkenners.webp";

// Bewegende WebP (365 frames). Verkleind naar 400px scheelt veel (561 KB i.p.v. 912 KB), maar op
// volle breedte maakt Astro hem groter dan het origineel. Daarom: kleine versie voor smalle schermen,
// het originele bestand voor brede. <Image /> kan het origineel niet in de srcset zetten, vandaar <img>.
const small = await getImage({ src: simulatorAnimation, width: 400, format: "webp" });
---

<MainLayout title="Stap 4"
nextHref="/onboarding/step-5"
backHref="/onboarding/step-3"
headingText="De beperking simulator"
bodyText="Rechtsboven in elke cursuspagina vind je de knop 'Simulator'. Daarmee boots je een beperking na, zoals wazig zicht, weinig contrast, dyslexie of een trillende hand. Zo ervaar je zelf hoe het is om de cursus te volgen als niet alles vanzelf gaat. Je kunt instellingen combineren en met 'Reset alle instellingen' zet je alles weer terug."
step={4}
totalSteps={10}
stepId="onboarding_step-4"
category="onboarding"
>

<img class="mockup"
  src="/images/mensenkenners.webp"
  srcset={`${small.src} 400w, /images/mensenkenners.webp 700w`}
  sizes="(min-width: 768px) 400px, 90vw"
  width="700"
  height="333"
  alt="Schermopname van een cursuspagina waarop de beperking simulator wordt gebruikt"
  loading="eager"
  decoding="async"
/>

</MainLayout>

<style>
.mockup {
  width: 100%;
  max-width: 90%;
}
</style>
