---
export const prerender = false;
import MainLayout from "../../layouts/Layout-onboarding.astro";
import OnboardingImage from "../../components/OnboardingImage.astro";
---

<MainLayout
  title="Welkom"
  nextHref="/onboarding/step-1"
  headingText="Welkom bij Mensenkenners!"
  bodyText="Jouw digitale training om je gedrag inclusiever te maken."
  step={1}
  totalSteps={5}
  showBack={false}
  showProgress={false}
>

  <OnboardingImage class="mockup"
    src="/images/mockupmensenkenners.webp"
    alt="Telefoon met een vraag uit de Mensenkenners-training: een filmje waarin een zus zich inleeft in haar visueel beperkte broer"
  />
</MainLayout>