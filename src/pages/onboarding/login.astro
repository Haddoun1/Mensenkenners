---
import MainLayout from "../../layouts/Layout-onboarding.astro";

export const prerender = false;
---

<MainLayout
  title="login"
  nextHref="/"
  backHref="/onboarding/step-11"
  headingText=""
  bodyText=""
  step={1}
  totalSteps={5}
  showProgress={false}
  showBack={false}
  showNext={false}
  mockupSrc="/images/Mensenkennerskaderdoof.webp"
  showDashboardButton={false}
  variant="login"
>
  
  <div class="logo-container-theme">
    <img
      class="logo-image logo-image--light"
      src="/images/logohorizontaal.png"
      alt="Stichting Mensenkenners logo"
    />
    <img
      class="logo-image logo-image--dark"
      src="/images/mensenkennerslogowit.png"
      alt="Stichting Mensenkenners logo"
    />

  </div>
  <form class="login-form" method="post">
    <fieldset>
      <div class="title-login">
        <legend>Login</legend>
      </div>

      <div class="container-name">
        <label for="email">
          E-mailadres
          <input type="email" id="email" name="email" required />
          <p class="error">Vul hier je e-mailadres in.</p>
        </label>

        <label for="password">
          Wachtwoord
          <input
            type="password"
            id="password"
            name="password"
            placeholder=""
            required
          />
          <p class="error">Vul hier je wachtwoord in.</p>
        </label>
      </div>

      <p class="login-link">
        Heb je nog geen account? <a href="/onboarding/register"
          >Maak een account</a
        >
      </p>
    </fieldset>

    <div class="buttons-onboarding">
      <a class="button-back" href="/onboarding/step-11" id="back-btn">
        <button type="button">Ga terug</button>
      </a>
      <button type="submit">Login</button>
    </div>
  </form>
</MainLayout>

<style>
  .logo-image {
    height: 40px;
    width: 160px;
    object-fit: contain;
    object-position: left;
  }

  .logo-image--dark {
    display: none;
  }

  :global(html.dark-mode) .logo-image--light {
    display: none;
  }

  :global(html.dark-mode) .logo-image--dark {
    display: block;
  }
</style>

<script>
  // @ts-nocheck
  import { supabase } from "../../lib/supabase";

  // Stuurt de "Ga terug"-knop naar de pagina waar de gebruiker vandaan kwam,
  // met de welkomstpagina als terugvaloptie.
  // Kwam de gebruiker van een pagina die alleen voor ingelogde gebruikers is
  // (een module of het profiel), dan zou teruggaan meteen weer naar de
  // login-pagina sturen. Stuur die gevallen daarom naar het dashboard.
  const backBtn = document.getElementById("back-btn");
  if (backBtn && document.referrer) {
    try {
      const referrerUrl = new URL(document.referrer);
      const cameFromProtectedPage =
        /^\/module-\d+\//.test(referrerUrl.pathname) ||
        referrerUrl.pathname === "/profile";

      if (cameFromProtectedPage) {
        backBtn.setAttribute("href", "/");
      } else if (
        referrerUrl.origin === window.location.origin &&
        referrerUrl.pathname !== window.location.pathname
      ) {
        backBtn.setAttribute("href", referrerUrl.pathname + referrerUrl.search);
      }
    } catch {
      // Ongeldige of ontbrekende referrer: val terug op de standaard-href.
    }
  }

  // Slaat onboardingstappen op die zijn doorlopen voordat de gebruiker inlogde
  // (zie saveProgress in Layout-onboarding.astro).
  async function savePendingOnboardingProgress(user) {
    let pending = [];
    try {
      pending = JSON.parse(localStorage.getItem("pendingOnboardingProgress") || "[]");
    } catch {
      return;
    }
    if (!user?.id || pending.length === 0) return;

    await Promise.all(
      pending.map((step) =>
        fetch("/api/track-step", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            userId: user.id,
            email: user.email || null,
            name: user.user_metadata?.name || null,
            ...step,
          }),
        }),
      ),
    );

    localStorage.removeItem("pendingOnboardingProgress");
  }

  // Waar de gebruiker na het inloggen heen gaat, bijvoorbeeld terug naar de onboarding.
  // Alleen interne paden zijn toegestaan; anders naar het dashboard.
  const nextParam = new URLSearchParams(window.location.search).get("next");
  const afterLoginUrl =
    nextParam && nextParam.startsWith("/") && !nextParam.startsWith("//") ? nextParam : "/";

  // Geeft de bestemming door aan de registratiepagina, zodat je na registreren en inloggen ook terugkomt.
  if (nextParam) {
    document
      .querySelectorAll('a[href="/onboarding/register"]')
      .forEach((link) => link.setAttribute("href", `/onboarding/register?next=${encodeURIComponent(afterLoginUrl)}`));
  }

  // Al ingelogd en via de onboarding hier gekomen: direct door naar de volgende stap.
  if (nextParam) {
    supabase.auth.getUser().then(({ data: { user } }) => {
      if (user) window.location.replace(afterLoginUrl);
    });
  }

  const form = document.querySelector(".login-form");
  const emailInput = document.getElementById("email");
  const passwordInput = document.getElementById("password");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const email = emailInput.value.trim();
    const password = passwordInput.value.trim();

    const { data, error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      console.error("Login error:", error.message);
      alert("Inloggen mislukt: " + error.message);
      return;
    }

    await savePendingOnboardingProgress(data.user);

    window.location.replace(afterLoginUrl);
  });
</script>