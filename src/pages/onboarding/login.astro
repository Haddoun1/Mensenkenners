---
import MainLayout from "../../layouts/Layout-onboarding.astro";
import ThemeLogo from "../../components/ThemeLogo.astro";

export const prerender = false;
---

<MainLayout
  title="login"
  nextHref="/"
  backHref="/onboarding/step-11"
  headingText=""
  bodyText=""
  step={1}
  totalSteps={5}
  showProgress={false}
  showBack={false}
  showNext={false}
  mockupSrc="/images/Mensenkennerskaderdoof.webp"
  mockupAlt="Vrouw maakt een handgebaar"
  showDashboardButton={false}
  variant="login"
>
  
  <div class="logo-container-theme">
    <ThemeLogo class="logo-image" />

  </div>
  <form class="login-form" method="post">
    <fieldset>
      <div class="title-login">
        <legend>Login</legend>
      </div>

      <div class="container-name">
        <label for="email">
          E-mailadres
          <input type="email" id="email" name="email" required />
          <p class="error">Vul hier je e-mailadres in.</p>
        </label>

        <label for="password">
          Wachtwoord
          <input
            type="password"
            id="password"
            name="password"
            placeholder=""
            required
          />
          <p class="error">Vul hier je wachtwoord in.</p>
        </label>
      </div>

      <p class="login-link">
        Heb je nog geen account? <a href="/onboarding/register"
          >Maak een account</a
        >
      </p>
    </fieldset>

    <div class="buttons-onboarding">
      <a class="button-back" href="/onboarding/step-11" id="back-btn">
        <span class="onboarding-btn">Ga terug</span>
      </a>
      <button type="submit">Login</button>
    </div>
  </form>
</MainLayout>

<style>
  .logo-image {
    height: 40px;
    width: 160px;
    object-fit: contain;
    object-position: left;
  }
</style>

<script>
  // @ts-nocheck
  import { supabase, authHeaders } from "../../lib/supabase";
  import { safeNextUrl } from "../../lib/safeNextUrl";
  import { ensureGroup } from "../../lib/groups";

  // Stuurt de "Ga terug"-knop naar de pagina waar de gebruiker vandaan kwam,
  // met de laatste onboardingstap (de standaard-href) als terugvaloptie.
  // Kwam de gebruiker van een pagina die alleen voor ingelogde gebruikers is
  // (een module of het profiel), dan zou teruggaan meteen weer naar de
  // login-pagina sturen. Stuur die gevallen daarom naar het dashboard.

  // Vorige pagina: bij een view transition uit sessionStorage (gezet in Layout-onboarding.astro),
  // alleen als die overgang echt naar deze pagina ging; anders bij een gewone paginalading de referrer.
  function getPreviousPage() {
    const here = location.pathname + location.search;
    try {
      const nav = JSON.parse(sessionStorage.getItem("onboardingPreviousPage") || "null");
      if (nav?.to === here) return nav.from;
    } catch {}
    try {
      const referrerUrl = new URL(document.referrer);
      if (referrerUrl.origin === location.origin) return referrerUrl.pathname + referrerUrl.search;
    } catch {}
    return null;
  }

  function setBackHref() {
    // Het script blijft actief na een view transition; alleen op de loginpagina uitvoeren.
    if (location.pathname !== "/onboarding/login") return;
    const backBtn = document.getElementById("back-btn");
    const previous = getPreviousPage();
    if (!backBtn || !previous) return;

    const previousPath = previous.split("?")[0];
    const cameFromProtectedPage = /^\/module-\d+\//.test(previousPath) || previousPath === "/profile";

    if (cameFromProtectedPage) {
      backBtn.setAttribute("href", "/");
    } else if (previousPath !== location.pathname && previousPath !== "/onboarding/register") {
      // Register zelf niet: daar wijst "Ga terug" weer naar login, dan blijf je heen en weer gaan.
      backBtn.setAttribute("href", previous);
    }
  }

  setBackHref();
  document.addEventListener("astro:page-load", setBackHref);

  // Slaat onboardingstappen op die zijn doorlopen voordat de gebruiker inlogde
  // (zie saveProgress in Layout-onboarding.astro).
  async function savePendingOnboardingProgress(user) {
    let pending = [];
    try {
      pending = JSON.parse(localStorage.getItem("pendingOnboardingProgress") || "[]");
    } catch {
      return;
    }
    if (!user?.id || pending.length === 0) return;

    const headers = await authHeaders();
    await Promise.all(
      pending.map((step) =>
        fetch("/api/track-step", {
          method: "POST",
          headers,
          body: JSON.stringify(step),
        }),
      ),
    );

    localStorage.removeItem("pendingOnboardingProgress");
  }

  // Waar de gebruiker na het inloggen heen gaat, bijvoorbeeld terug naar de onboarding.
  // Alleen interne paden zijn toegestaan (zie safeNextUrl); anders naar het dashboard.
  const nextParam = new URLSearchParams(window.location.search).get("next");
  const afterLoginUrl = safeNextUrl(nextParam);

  // Geeft de bestemming door aan de registratiepagina, zodat je na registreren en inloggen ook terugkomt.
  if (nextParam) {
    document
      .querySelectorAll('a[href="/onboarding/register"]')
      .forEach((link) => link.setAttribute("href", `/onboarding/register?next=${encodeURIComponent(afterLoginUrl)}`));
  }

  // Al ingelogd en via de onboarding hier gekomen: direct door naar de volgende stap.
  if (nextParam) {
    supabase.auth.getUser().then(async ({ data: { user } }) => {
      if (user && (await ensureGroup(user, afterLoginUrl))) window.location.replace(afterLoginUrl);
    });
  }

  const form = document.querySelector(".login-form");
  const emailInput = document.getElementById("email");
  const passwordInput = document.getElementById("password");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const email = emailInput.value.trim();
    const password = passwordInput.value.trim();

    const { data, error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      console.error("Login error:", error.message);
      alert("Inloggen mislukt: " + error.message);
      return;
    }

    await savePendingOnboardingProgress(data.user);

    // Nog geen groep? Dan stuurt ensureGroup eerst naar /groep, en daarna door naar de bestemming.
    if (await ensureGroup(data.user, afterLoginUrl)) {
      window.location.replace(afterLoginUrl);
    }
  });
</script>