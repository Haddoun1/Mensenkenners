---
import MainLayout from "../../layouts/Layout-onboarding.astro";
import ThemeLogo from "../../components/ThemeLogo.astro";

export const prerender = false;
---

<MainLayout
  title="login"
  nextHref="/"
  backHref="/"
  headingText=""
  bodyText=""
  step={1}
  totalSteps={5}
  showProgress={false}
  showBack={false}
  showNext={false}
  mockupSrc="/images/Mensenkennerskaderdoof.webp"
  mockupAlt="Vrouw maakt een gebaar in gebarentaal"
  showDashboardButton={false}
  variant="login"
>
  
  <div class="logo-container-theme">
    <ThemeLogo class="logo-image" />

  </div>
  <form class="login-form" method="post">
    <fieldset>
      <div class="title-login">
        <legend>Login</legend>
      </div>

      <div class="container-name">
        <label for="email">
          E-mailadres
          <input type="email" id="email" name="email" required />
          <p class="error">Vul hier je e-mailadres in.</p>
        </label>

        <label for="password">
          Wachtwoord
          <input
            type="password"
            id="password"
            name="password"
            placeholder=""
            required
          />
          <p class="error">Vul hier je wachtwoord in.</p>
        </label>
        <a class="forgot-password" href="/onboarding/wachtwoord-vergeten">Wachtwoord vergeten?</a>
      </div>

      <!-- Meldingen bij het inloggen, bijvoorbeeld als het e-mailadres nog niet is bevestigd. -->
      <div class="login-status" id="login-status" role="alert" hidden>
        <p id="login-status-text"></p>
        <button type="button" class="login-resend" id="login-resend" hidden>
          Stuur de bevestigingsmail opnieuw
        </button>
      </div>

      <p class="login-link">
        Heb je nog geen account? <a href="/onboarding/register"
          >Maak een account</a
        >
      </p>
    </fieldset>

    <div class="buttons-onboarding">
      <!-- "Ga terug" gaat altijd naar het dashboard. -->
      <a class="button-back" href="/" id="back-btn">
        <span class="onboarding-btn">Ga terug</span>
      </a>
      <button type="submit">Login</button>
    </div>
  </form>
</MainLayout>

<style>
  .logo-image {
    height: 40px;
    width: 160px;
    object-fit: contain;
    object-position: left;
  }
</style>

<script>
  // @ts-nocheck
  import { supabase, authHeaders } from "../../lib/supabase";
  import { safeNextUrl } from "../../lib/safeNextUrl";
  import { saveSignupGroup } from "../../lib/groups";
  import { resendConfirmation, isEmailNotConfirmed } from "../../lib/emailConfirm";

  // Slaat onboardingstappen op die zijn doorlopen voordat de gebruiker inlogde
  // (zie saveProgress in Layout-onboarding.astro).
  async function savePendingOnboardingProgress(user) {
    let pending = [];
    try {
      pending = JSON.parse(localStorage.getItem("pendingOnboardingProgress") || "[]");
    } catch {
      return;
    }
    if (!user?.id || pending.length === 0) return;

    const headers = await authHeaders();
    await Promise.all(
      pending.map((step) =>
        fetch("/api/track-step", {
          method: "POST",
          headers,
          body: JSON.stringify(step),
        }),
      ),
    );

    localStorage.removeItem("pendingOnboardingProgress");
  }

  // Slaat antwoorden op onboardingvragen op die zijn gegeven voordat de gebruiker inlogde
  // (zie setupAnswers in Layout-onboarding.astro).
  async function savePendingOnboardingAnswers(user) {
    let pending = {};
    try {
      pending = JSON.parse(localStorage.getItem("pendingOnboardingAnswers") || "{}");
    } catch {
      return;
    }
    const rows = Object.entries(pending).map(([questionId, answer]) => ({
      user_id: user?.id,
      category: "onboarding",
      question_id: questionId,
      answer,
      updated_at: new Date().toISOString(),
    }));
    if (!user?.id || rows.length === 0) return;

    const { error } = await supabase
      .from("course_answers")
      .upsert(rows, { onConflict: "user_id,category,question_id" });

    if (error) console.error("Onboarding-antwoorden opslaan mislukt:", error.message);
    else localStorage.removeItem("pendingOnboardingAnswers");
  }

  // Waar de gebruiker na het inloggen heen gaat, bijvoorbeeld terug naar de onboarding.
  // Alleen interne paden zijn toegestaan (zie safeNextUrl); anders naar het dashboard.
  const nextParam = new URLSearchParams(window.location.search).get("next");
  const afterLoginUrl = safeNextUrl(nextParam);

  // Geeft de bestemming door aan de registratiepagina, zodat je na registreren en inloggen ook terugkomt.
  if (nextParam) {
    document
      .querySelectorAll('a[href="/onboarding/register"]')
      .forEach((link) => link.setAttribute("href", `/onboarding/register?next=${encodeURIComponent(afterLoginUrl)}`));
  }

  const form = document.querySelector(".login-form");
  const emailInput = document.getElementById("email");
  const passwordInput = document.getElementById("password");

  // Melding boven "Maak een account". Met showResend verschijnt ook de knop om de bevestigingsmail opnieuw te sturen.
  const status = document.getElementById("login-status");
  const statusText = document.getElementById("login-status-text");
  const resendBtn = document.getElementById("login-resend");

  function showStatus(message, { error = false, showResend = false } = {}) {
    statusText.textContent = message;
    status.classList.toggle("is-error", error);
    resendBtn.hidden = !showResend;
    status.hidden = false;
  }

  resendBtn.addEventListener("click", async () => {
    const email = emailInput.value.trim();
    if (!email) {
      showStatus("Vul eerst je e-mailadres in.", { error: true, showResend: true });
      return;
    }
    resendBtn.disabled = true;
    const error = await resendConfirmation(email, nextParam);
    showStatus(
      error
        ? "Opnieuw sturen lukte niet: " + error
        : `De bevestigingsmail is opnieuw verstuurd naar ${email}.`,
      { error: Boolean(error), showResend: true },
    );
    // Even wachten voordat het weer kan; Supabase staat maar een paar mails per tijd toe.
    setTimeout(() => (resendBtn.disabled = false), 30000);
  });

  // Alles wat na een geslaagde login moet gebeuren, daarna door naar de bestemming.
  async function finishLogin(user) {
    await savePendingOnboardingProgress(user);
    await savePendingOnboardingAnswers(user);

    // Groep die bij het registreren is gekozen opslaan in het profiel.
    await saveSignupGroup(user);
    window.location.replace(afterLoginUrl);
  }

  // Terug via de link in de bevestigingsmail (?bevestigd=1). Supabase logt dan meestal direct in.
  const fromConfirmLink = new URLSearchParams(window.location.search).has("bevestigd");
  const hashParams = new URLSearchParams(window.location.hash.slice(1));

  if (fromConfirmLink && hashParams.get("error")) {
    // Bijvoorbeeld een verlopen of al gebruikte link.
    showStatus(
      "Deze bevestigingslink is verlopen of al gebruikt. Vul je e-mailadres in en vraag een nieuwe mail aan, of log in als je al bevestigd bent.",
      { error: true, showResend: true },
    );
  }

  // Al ingelogd (via de onboarding of de bevestigingslink): direct door naar de volgende stap.
  if (nextParam || fromConfirmLink) {
    supabase.auth.getUser().then(({ data: { user } }) => {
      if (user) finishLogin(user);
      else if (fromConfirmLink && !hashParams.get("error")) {
        showStatus("Je e-mailadres is bevestigd. Log nu in om verder te gaan.");
      }
    });
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const email = emailInput.value.trim();
    const password = passwordInput.value.trim();

    const { data, error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      console.error("Login error:", error.message);
      if (isEmailNotConfirmed(error)) {
        showStatus(
          "Je e-mailadres is nog niet bevestigd. Klik op de link in de mail die we je hebben gestuurd.",
          { error: true, showResend: true },
        );
      } else if (error.code === "invalid_credentials" || /invalid login credentials/i.test(error.message)) {
        showStatus("Het e-mailadres of wachtwoord klopt niet.", { error: true });
      } else {
        showStatus("Inloggen mislukt: " + error.message, { error: true });
      }
      return;
    }

    await finishLogin(data.user);
  });
</script>