---
// Deze pagina mag niet vooraf statisch gebouwd worden.
// We moeten namelijk kunnen controleren of een formulier is verstuurd.
export const prerender = false;

// Importeert de server-side Supabase client.
// Hiermee kunnen we veilig inloggen op de server.
import { createSupabaseServerClient } from "../../lib/supabaseServer";
import FixedThemeToggle from "../../components/FixedThemeToggle.astro";

let errorMessage = "";
let email = "";

// Controleert of het formulier werd verstuurd.
if (Astro.request.method === "POST") {
  // Leest alle velden uit het formulier.
  const formData = await Astro.request.formData();

  // Haalt het e-mailadres op uit het formulier.
  email = String(formData.get("email") || "");

  // Haalt het wachtwoord op uit het formulier.
  const password = String(formData.get("password") || "");

  // Maakt een server-side Supabase client aan.
  const supabase = createSupabaseServerClient(Astro);

  // Probeert in te loggen met e-mail en wachtwoord.
  const { error } = await supabase.auth.signInWithPassword({
    email,
    password,
  });

  // Als de login mislukt, tonen we een foutmelding.
  if (error) {
    errorMessage = "Inloggen is niet gelukt. Controleer je e-mailadres en wachtwoord.";
  } else {
    // Als de login lukt, sturen we de gebruiker
    // direct door naar het admin dashboard.
    return Astro.redirect("/admin");
  }
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Inloggen | Mensenkenners Adminpaneel</title>

<!-- Zelfde lettertypes als het adminpaneel -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap"
  rel="stylesheet"
/>
<script is:inline>
  if (localStorage.getItem("theme") === "dark") {
    document.documentElement.classList.add("dark-mode");
  }
</script>

<!-- Light/dark mode knop rechtsboven, net als op de andere pagina's -->
<FixedThemeToggle />

<main class="login-page">
  <section class="login-card" aria-labelledby="login-title">
    <img
      class="logo logo--light"
      src="/images/logohorizontaal.png"
      alt="Stichting Mensenkenners"
    />
    <img
      class="logo logo--dark"
      src="/images/mensenkennerslogowit.png"
      alt="Stichting Mensenkenners"
    />

    <h1 id="login-title">Adminpaneel</h1>
    <p class="intro">Log in met je admin-account om de resultaten van de training te bekijken.</p>

    {errorMessage && (
      <p class="error" role="alert">{errorMessage}</p>
    )}

    <form id="admin-login-form" method="POST">
      <label for="email">E-mailadres</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        value={email}
        required
      />

      <label for="password">Wachtwoord</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
      />

      <button type="submit">Inloggen</button>
    </form>

    <a class="back-link" href="/">← Terug naar de training</a>
  </section>
</main>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* Zelfde kleuren als het adminpaneel (afkomstig uit public/styles/global.css). */
  :root {
    color-scheme: light;
    --accent: #2ab789;
    --bg: light-dark(#f6faf8, #161a18);
    --surface: light-dark(#ffffff, #1b1f1d);
    --border: light-dark(#e3e8e6, #313835);
    --text: light-dark(#222020, #ffffff);
    --muted: light-dark(#6b6e73, #a3a9ae);
    --danger: light-dark(#9f2b00, #ffb199);
    --danger-light: light-dark(#fff0ed, #35180f);
    --danger-mid: #ff6631;
    --font: "DM Sans", sans-serif;

    /* Variabelen die de ThemeToggle-knop gebruikt. */
    --color-text: var(--text);
    --color-surface: var(--surface);
    --color-cyan: light-dark(#B1F2D9, #1e4d3a);

    &.dark-mode {
      color-scheme: dark;
    }
  }

  :global(body) {
    font-family: var(--font);
    color: var(--text);
    background:
      radial-gradient(circle at 0% 0%, light-dark(#b5dbce66, #3b816640) 0%, transparent 55%),
      var(--bg);
    min-height: 100vh;
  }

  .login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem 1rem;
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2.5rem 2rem 2rem;
    box-shadow: 0 12px 40px color-mix(in srgb, var(--text) 8%, transparent);
  }

  .logo {
    display: block;
    height: 40px;
    width: auto;
    max-width: 100%;
    margin-bottom: 2rem;
  }

  .logo--dark {
    display: none;
  }

  :global(html.dark-mode) .logo--light {
    display: none;
  }

  :global(html.dark-mode) .logo--dark {
    display: block;
  }

  h1 {
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.4rem;
  }

  .intro {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 1.75rem;
  }

  .error {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--danger);
    background: var(--danger-light);
    border: 1px solid var(--danger-mid);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }

  form {
    display: flex;
    flex-direction: column;
  }

  label {
    font-size: 0.8rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
  }

  input {
    font-family: var(--font);
    font-size: 0.95rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.1rem;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  input:hover {
    border-color: color-mix(in srgb, var(--text) 30%, transparent);
  }

  input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  button {
    margin-top: 0.5rem;
    font-family: var(--font);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    background: var(--color-cyan);
    border: 2px solid var(--text);
    border-radius: 99px;
    padding: 0.75rem 1rem;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  button:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  button:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }

  .back-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--text);
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .login-card {
      padding: 2rem 1.25rem 1.5rem;
    }
  }
</style>

<!-- Bronnen
  https://supabase.com/docs/guides/auth -->
