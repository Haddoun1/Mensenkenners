---
// @ts-nocheck

// Deze pagina mag niet vooraf statisch gebouwd worden,
// omdat hij eerst moet checken of iemand is ingelogd en admin is.
export const prerender = false;

// Importeert de server-side Supabase client.
// Deze kan cookies lezen en dus veilig controleren wie is ingelogd.
import { createSupabaseServerClient } from "../../lib/supabaseServer";
import data from "../../data/mensenkennersvragen.json";
import { slugify } from "../../utils/slugify";
import FixedThemeToggle from "../../components/FixedThemeToggle.astro";

// Maakt een Supabase client aan voor deze pagina.
const supabase = createSupabaseServerClient(Astro);

// Haalt de huidige ingelogde gebruiker op.
const {
  data: { user },
} = await supabase.auth.getUser();

// Als er geen gebruiker is ingelogd, stuur diegene naar de admin login.
if (!user) {
  return Astro.redirect("/admin/login");
}

// Haalt het profiel van de gebruiker op om te controleren of die admin is.
const { data: profile, error: profileError } = await supabase
  .from("profiles")
  .select("role")
  .eq("id", user.id)
  .single();

// Als er een fout is of de gebruiker is geen admin,
// stuur diegene terug naar het normale dashboard.
if (profileError || profile?.role !== "admin") {
  return Astro.redirect("/admin/login?geen-toegang");
}

// Haalt alle opgeslagen cursusvoortgang op uit Supabase.
// Nieuwste records komen bovenaan.
const { data: progress, error } = await supabase
  .from("course_progress")
  .select("*")
  .order("created_at", { ascending: false });

// Als er geen data is, gebruiken we een lege array zodat de pagina niet crasht.
// Rijen met step_id "reset" (cursus opnieuw gestart) zijn geen echte stap en tellen niet mee.
const records = (progress || []).filter((row) => row.step_id !== "reset");

// Telt hoeveel unieke gebruikers er zijn.
const uniqueUsers = new Set(records.map((row) => row.user_id)).size;

// Groepeert alle records eerst per cursus/categorie,
// en daarna per gebruiker.
const byCategory: any = records.reduce((acc: any, row: any) => {
  const cat = row.category || "Onbekend";
  const uid = row.user_id || "anonymous";

  // Maakt een categorie aan als die nog niet bestaat.
  if (!acc[cat]) acc[cat] = {};

  // Maakt een gebruiker aan binnen de categorie als die nog niet bestaat.
  if (!acc[cat][uid]) {
    acc[cat][uid] = {
      name: row.name || row.user_id || "Onbekend",
      userId: uid,
      stepCount: 0,
      totalSeconds: 0,
      lastSeen: row.created_at,
      lastStep: row.step_id,
    };
  }

  // Verhoogt het aantal opgeslagen stappen voor deze gebruiker.
  acc[cat][uid].stepCount += 1;

  // Telt de actieve tijd van deze gebruiker op.
  acc[cat][uid].totalSeconds += row.duration_seconds || 0;

  // Checkt of dit record nieuwer is dan de laatst bekende activiteit.
  if (new Date(row.created_at) > new Date(acc[cat][uid].lastSeen)) {
    acc[cat][uid].lastSeen = row.created_at;
    acc[cat][uid].lastStep = row.step_id;
  }

  return acc;
}, {});

// Zet het gegroepeerde object om naar een array,
// zodat Astro er makkelijk doorheen kan loopen.
const categories = Object.entries(byCategory).map(([name, usersObj]) => ({
  name,
  users: Object.values(usersObj as any),
}));

// ── Afhaakanalyse ────────────────────────────────────────────────
// Per module: hoeveel deelnemers bereiken elke stap, en bij welke stap stoppen ze.

// Wie langer dan zoveel dagen niets meer in een module heeft gedaan, telt als afgehaakt.
// Wie korter geleden actief was, telt als "nog bezig".
const DROP_AFTER_DAYS = 3;
const MAX_STEP_SECONDS = 20 * 60;
const now = Date.now();

// Haalt het stapnummer uit een step_id, bijvoorbeeld "4" of "onboarding_step-4".
const stepNumber = (stepId) => {
  const match = String(stepId).match(/(\d+)$/);
  return match ? Number(match[1]) : null;
};

const typeLabels = { question: "Vraag", video: "Video", content: "Tekst", onboarding: "Stap" };

// Zelfde kleuren per module als in de cursus (public/styles/global.css), licht en donker.
// In de donkere modus gebruiken we ook de heldere kleuren: de donkere varianten uit de cursus
// zijn bedoeld als achtergrond en vallen als balk weg tegen de donkere achtergrond.
const moduleColors = {
  intro: "#B1F2D9",
  "module-1": "#FF94E1",
  "module-2": "#E9F279",
  "module-3": "#FF6631",
  "module-4": "#647bef",
};

// Bouwt de stappen per module op in dezelfde volgorde als de cursuspagina's.
const moduleSteps: any = {
  onboarding: {
    name: "Onboarding",
    steps: Array.from({ length: 11 }, (_, i) => ({ title: `Onboardingstap ${i + 1}`, type: "onboarding" })),
  },
};
data.blocks
  .filter((block) => (block.Category ?? block.category) && ["content", "video", "question"].includes(block.type))
  .forEach((block) => {
    const name = block.Category ?? block.category;
    const slug = slugify(name);
    if (!moduleSteps[slug]) moduleSteps[slug] = { name, steps: [] };
    moduleSteps[slug].steps.push({ title: block.title, type: block.type });
  });

const funnels = Object.entries(moduleSteps)
  .map(([slug, mod]: any) => {
    const total = mod.steps.length;

    // Per deelnemer: de verste stap in deze module en wanneer die voor het laatst actief was.
    // Anonieme bezoekers (niet ingelogd) zijn niet van elkaar te onderscheiden en tellen niet mee.
    const users: any = {};
    records
      .filter((row) => row.category === slug && row.user_id && row.user_id !== "anonymous")
      .forEach((row) => {
        const n = stepNumber(row.step_id);
        if (!n || n > total) return;
        const user = (users[row.user_id] ||= { furthest: 0, lastSeen: 0, seconds: 0 });
        user.furthest = Math.max(user.furthest, n);
        // Een tabblad dat lang openstaat telt niet als leertijd: maximaal MAX_STEP_SECONDS per stap.
        user.seconds += Math.min(row.duration_seconds || 0, MAX_STEP_SECONDS);
        user.lastSeen = Math.max(user.lastSeen, new Date(row.ended_at || row.created_at).getTime());
      });

    const list: any[] = Object.values(users);
    const started = list.length;
    const completedUsers = list.filter((user) => user.furthest >= total);
    const completed = completedUsers.length;
    // Gemiddelde tijd van de deelnemers die de module helemaal hebben afgerond.
    const avgSeconds = completed
      ? completedUsers.reduce((sum, user) => sum + user.seconds, 0) / completed
      : null;

    const steps = mod.steps.map((step, i) => {
      const n = i + 1;
      const reached = list.filter((user) => user.furthest >= n).length;
      const stoppedHere = n < total ? list.filter((user) => user.furthest === n) : [];
      const dropped = stoppedHere.filter(
        (user) => now - user.lastSeen > DROP_AFTER_DAYS * 24 * 60 * 60 * 1000,
      ).length;
      return {
        n,
        title: step.title,
        typeLabel: typeLabels[step.type] || step.type,
        reached,
        percentage: started ? Math.round((reached / started) * 100) : 0,
        dropped,
        busy: stoppedHere.length - dropped,
      };
    });

    const maxDropped = Math.max(0, ...steps.map((step) => step.dropped));
    const worstStep = maxDropped > 0 ? steps.find((step) => step.dropped === maxDropped) : null;

    return { slug, name: mod.name, started, completed, avgSeconds, steps, maxDropped, worstStep };
  })
  .filter((funnel) => funnel.started > 0);

// Gemiddelde tijd voor de hele cursus: de gemiddelde tijd per module (Module 1 t/m 4) bij elkaar opgeteld.
const courseModules = Object.keys(moduleSteps).filter((slug) => slug.startsWith("module-"));
const timedModules = funnels.filter((funnel) => courseModules.includes(funnel.slug) && funnel.avgSeconds !== null);
const courseAvgMinutes = timedModules.length
  ? Math.round(timedModules.reduce((sum, funnel) => sum + funnel.avgSeconds, 0) / 60)
  : null;
const missingTimedModules = courseModules.length - timedModules.length;

// ── "Wat neem je mee?" ───────────────────────────────────────────
// Haalt de antwoorden op de afsluitende reflectievraag van elke module op.
// Admins mogen alle antwoorden lezen dankzij supabase/course_answers_admin.sql.
const { data: takeawayRows, error: takeawayError } = await supabase
  .from("course_answers")
  .select("category, question_id, answer, updated_at")
  .like("question_id", "%_meenemen")
  .order("updated_at", { ascending: false });

// Antwoorden worden bewust anoniem getoond: geen naam, e-mail of gebruikers-id.

const takeaways = Object.entries(moduleSteps)
  .filter(([slug]) => slug.startsWith("module-"))
  .map(([slug, mod]: any) => ({
    slug,
    name: mod.name,
    answers: (takeawayRows || [])
      .filter((row) => row.category === slug)
      .map((row) => ({
        text: String(row.answer?.values?.[0] ?? "").trim(),
        date: row.updated_at,
      }))
      .filter((answer) => answer.text),
  }));

const totalTakeaways = takeaways.reduce((sum, mod) => sum + mod.answers.length, 0);
---

<!-- Zorgt dat tekens als – en ë goed worden weergegeven -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Mensenkenners Adminpaneel</title>

<!-- Laadt Google Fonts voor het admin dashboard -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500;600&display=swap"
  rel="stylesheet"
/>
<script is:inline>
  if (localStorage.getItem("theme") === "dark") {
    document.documentElement.classList.add("dark-mode");
  }
</script>

<!-- Light/dark mode knop rechtsboven, net als op de andere pagina's -->
<FixedThemeToggle />

<main>
  <div class="shell">
    <!-- Bovenste balk van het dashboard -->
    <header>
      <div class="header-left">
        <h1>Mensenkenners Adminpaneel</h1>
      </div>
    </header>

    <!-- Toont een foutmelding als Supabase data ophalen mislukt -->
    {
      error && (
        <div class="error-bar">
          <span>⚠</span> Fout bij ophalen data: {error.message}
        </div>
      )
    }

    <div class="section-intro section-intro--top">
      <h2 class="section-title">Algemeen</h2>
    </div>

    <!-- Statistieken bovenaan het dashboard -->
    <section class="stats-grid">
      <article class="stat-card accent">
        <p class="stat-label">Gemiddelde tijd hele cursus</p>
        <p class="stat-value">
          {courseAvgMinutes !== null ? courseAvgMinutes : "–"}<span class="stat-unit">min</span>
        </p>
        {missingTimedModules > 0 && courseAvgMinutes !== null && (
          <p class="stat-note">{timedModules.length} van {courseModules.length} modules</p>
        )}
      </article>

      <article class="stat-card">
        <p class="stat-label">Unieke gebruikers</p>
        <p class="stat-value">{uniqueUsers}</p>
      </article>

      <article class="stat-card">
        <p class="stat-label">Cursussen actief</p>
        <p class="stat-value">{categories.length}</p>
      </article>
    </section>

    <!-- Afhaakanalyse: per module tot welke stap deelnemers komen en waar ze stoppen -->
    <section class="dropoff">
      <div class="section-intro">
        <h2 class="section-title">Waar haken deelnemers af?</h2>
        <p class="section-text">
          Per module zie je hoeveel deelnemers elke stap hebben bereikt. Bij <strong>Afgehaakt</strong>
          staan de deelnemers die bij die stap zijn gestopt en al {DROP_AFTER_DAYS} dagen niet meer actief
          waren in de module. Wie korter geleden actief was, staat bij <strong>Nog bezig</strong>.
        </p>
      </div>

      {funnels.length === 0 && <p class="section-text">Er is nog geen voortgang van ingelogde deelnemers.</p>}

      {
        funnels.map((funnel) => (
          <details class="card funnel" style={`--module-color: ${moduleColors[funnel.slug] ?? "var(--accent)"}`}>
            <summary class="card-header">
              <div class="cat-info">
                <span class="cat-dot" />
                <h2>{funnel.name}</h2>
              </div>

              <div class="pills">
                <span class="pill">{funnel.started} gestart</span>
                <span class="pill accent-pill">
                  {funnel.completed} afgerond ({Math.round((funnel.completed / funnel.started) * 100)}%)
                </span>
                {funnel.worstStep && (
                  <span class="pill danger-pill">
                    Meeste afhakers: stap {funnel.worstStep.n} ({funnel.worstStep.dropped})
                  </span>
                )}
              </div>
            </summary>

            {/* Kolomdiagram: hoeveel deelnemers bereikten elke stap */}
            <figure class="chart" data-chart>
              <figcaption class="chart-caption">Aantal deelnemers dat elke stap bereikte</figcaption>

              <div class="chart-body" style={`--steps: ${funnel.steps.length}`}>
                <div class="chart-yaxis" aria-hidden="true">
                  <span>{funnel.started}</span>
                  <span>{Math.round(funnel.started / 2)}</span>
                  <span>0</span>
                </div>

                <div class="chart-plot">
                  <div class="chart-grid" aria-hidden="true">
                    <span /><span /><span />
                  </div>
                  <div class="chart-columns">
                    {funnel.steps.map((step) => {
                      const isWorst = funnel.maxDropped > 0 && step.dropped === funnel.maxDropped;
                      return (
                        <button
                          type="button"
                          class:list={["chart-col", { "is-worst": isWorst }]}
                          data-step={step.n}
                          data-title={step.title}
                          data-type={step.typeLabel}
                          data-reached={`${step.reached} van ${funnel.started} (${step.percentage}%)`}
                          data-dropped={step.dropped}
                          data-busy={step.busy}
                          aria-label={`Stap ${step.n}, ${step.title}: ${step.reached} bereikt, ${step.dropped} afgehaakt`}
                        >
                          {isWorst && (
                            <span class="chart-flag" style={`bottom: calc(${step.percentage}% + 0.4rem)`}>
                              Meeste afhakers
                            </span>
                          )}
                          <span class="chart-bar" style={`height: ${step.percentage}%`} />
                        </button>
                      );
                    })}
                  </div>
                </div>

                <span class="chart-row-label" aria-hidden="true">Stap</span>
                <div class="chart-xaxis" aria-hidden="true">
                  {funnel.steps.map((step) => <span>{step.n}</span>)}
                </div>

                <span class="chart-row-label" aria-hidden="true">Afgehaakt</span>
                <div class="chart-drops" aria-hidden="true">
                  {funnel.steps.map((step) => (
                    <span class:list={{ "has-drops": step.dropped > 0 }}>{step.dropped > 0 ? step.dropped : ""}</span>
                  ))}
                </div>
              </div>

              <div class="chart-tooltip" data-chart-tooltip hidden />
            </figure>

            <div class="table-wrap">
              <table class="funnel-table">
                <thead>
                  <tr>
                    <th>Stap</th>
                    <th>Onderdeel</th>
                    <th>Bereikt</th>
                    <th>Afgehaakt</th>
                    <th>Nog bezig</th>
                  </tr>
                </thead>
                <tbody>
                  {funnel.steps.map((step) => (
                    <tr class:list={{ "is-worst": funnel.maxDropped > 0 && step.dropped === funnel.maxDropped }}>
                      <td class="mono muted">{step.n}</td>
                      <td>
                        <span class="type-tag">{step.typeLabel}</span>
                        {step.title}
                      </td>
                      <td class="reached-cell">
                        <div class="bar" aria-hidden="true">
                          <span class="bar-fill" style={`width: ${step.percentage}%`} />
                        </div>
                        <span class="mono">{step.reached} ({step.percentage}%)</span>
                      </td>
                      <td>
                        {step.dropped > 0 ? (
                          <span class="drop-count">{step.dropped}</span>
                        ) : (
                          <span class="muted">–</span>
                        )}
                      </td>
                      <td class="mono muted">{step.busy > 0 ? step.busy : "–"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        ))
      }
    </section>

    <!-- Antwoorden op "Wat neem je mee?" per module -->
    <section class="takeaways">
      <div class="section-intro">
        <h2 class="section-title">Wat nemen deelnemers mee?</h2>
        <p class="section-text">
          De antwoorden op de vraag "Wat neem je uit deze module mee naar je eigen dag, bijeenkomst of
          activiteit?", per module. Nieuwste antwoorden staan bovenaan.
        </p>
      </div>

      {takeawayError && (
        <div class="error-bar">
          <span>⚠</span> Antwoorden ophalen mislukt: {takeawayError.message}
        </div>
      )}

      {!takeawayError && totalTakeaways === 0 && (
        <p class="section-text">
          Er zijn nog geen antwoorden. Weet je zeker dat er wel antwoorden zijn? Controleer dan of
          <code>supabase/course_answers_admin.sql</code> in Supabase is uitgevoerd, zodat admins alle antwoorden mogen lezen.
        </p>
      )}

      {totalTakeaways > 0 &&
        takeaways.map((mod) => (
          <details class="card" style={`--module-color: ${moduleColors[mod.slug] ?? "var(--accent)"}`}>
            <summary class="card-header">
              <div class="cat-info">
                <span class="cat-dot module-dot" />
                <h2>{mod.name}</h2>
              </div>
              <div class="pills">
                <span class="pill">
                  {mod.answers.length} {mod.answers.length === 1 ? "antwoord" : "antwoorden"}
                </span>
              </div>
            </summary>

            {mod.answers.length === 0 ? (
              <p class="takeaway-empty">Nog geen antwoorden in deze module.</p>
            ) : (
              <ul class="takeaway-list">
                {mod.answers.map((answer) => (
                  <li class="takeaway">
                    <p class="takeaway-text">{answer.text}</p>
                    <span class="takeaway-date mono muted">{new Date(answer.date).toLocaleDateString("nl-NL")}</span>
                  </li>
                ))}
              </ul>
            )}
          </details>
        ))}
    </section>

    <!-- Admin tools onderaan het dashboard -->
    <section class="admin-tools card">
      <div class="card-header">
        <div class="cat-info">
          <span class="cat-dot"></span>
          <h2>Admin Tools</h2>
        </div>
      </div>

      <div class="admin-tools-body">
        <!-- Formulier om een wachtwoord-resetmail te sturen -->
        <p class="tool-description">
          Verstuur een wachtwoord-resetlink naar een gebruiker.
        </p>

        <form id="reset-form">
          <input
            id="reset-email"
            type="email"
            placeholder="E-mailadres gebruiker"
            required
          />

          <button class="resetBtn" type="submit">Stuur resetlink</button>

          <!-- Hier komt feedback te staan na versturen -->
          <p id="reset-message"></p>
        </form>

        <!-- Formulier om adminrechten te beheren -->
        <p class="tool-description">
          Maak een gebruiker admin, of verwijder admin rechten.
        </p>

        <form id="admin-role-form">
          <input
            id="admin-email"
            type="email"
            placeholder="E-mailadres gebruiker"
            required
          />

          <button type="button" id="make-admin-btn" class="resetBtn">
            Maak admin
          </button>

          <button type="button" id="remove-admin-btn" class="resetBtn">
            Verwijder admin
          </button>

          <!-- Hier komt feedback te staan na admin-actie -->
          <p id="admin-role-message"></p>
        </form>
      </div>
    </section>
  </div>
</main>

<script>
  // Zorgt ervoor dat TypeScript geen errors geeft in dit browser-script.
  // @ts-nocheck

  // Importeert de normale Supabase client voor browser-acties.
  import { supabase } from "../../lib/supabase";

  // Elementen voor het reset-password formulier.
  const form = document.getElementById("reset-form");
  const message = document.getElementById("reset-message");

  // Luistert naar het versturen van het resetformulier.
  form.addEventListener("submit", async (e) => {
    // Voorkomt dat de pagina herlaadt.
    e.preventDefault();

    // Haalt het ingevulde e-mailadres op.
    const email = document.getElementById("reset-email").value;

    // Stuurt via Supabase een resetmail naar de gebruiker.
    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/update-password`,
    });

    // Toont eerst een simpele melding.
    message.textContent = error
      ? "Resetmail versturen mislukt."
      : "Resetmail verstuurd.";

    // Als er een fout is, toon de echte foutmelding in de console en op de pagina.
    if (error) {
      console.error(error);
      message.textContent = error.message;
      return;
    }
  });

  // Elementen voor het beheren van adminrechten.
  const adminEmailInput = document.getElementById("admin-email");
  const makeAdminBtn = document.getElementById("make-admin-btn");
  const removeAdminBtn = document.getElementById("remove-admin-btn");
  const adminRoleMessage = document.getElementById("admin-role-message");

  // Functie die een gebruiker admin maakt of adminrechten verwijdert.
  async function updateAdminRole(action) {
    // Haalt het ingevulde e-mailadres op.
    const email = adminEmailInput.value;

    // Stuurt de actie naar een server-side API-route.
    // De server controleert daarna of de huidige gebruiker admin is.
    const response = await fetch("/api/admin-role", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ email, action }),
    });

    // Leest het antwoord van de API-route.
    const result = await response.json();

    // Toont de melding op de pagina.
    adminRoleMessage.textContent = result.message;
  }

  // Klik op "Maak admin".
  makeAdminBtn.addEventListener("click", () => {
    updateAdminRole("add");
  });

  // Klik op "Verwijder admin".
  removeAdminBtn.addEventListener("click", () => {
    updateAdminRole("remove");
  });

  // Tooltip bij het afhaakdiagram: toont de details van de kolom waar je op staat.
  document.querySelectorAll("[data-chart]").forEach((chart) => {
    const tooltip = chart.querySelector("[data-chart-tooltip]");

    const line = (label, value) => {
      const row = document.createElement("div");
      row.className = "chart-tooltip-row";
      const strong = document.createElement("strong");
      strong.textContent = value;
      const span = document.createElement("span");
      span.textContent = label;
      row.append(strong, span);
      return row;
    };

    const show = (col) => {
      const heading = document.createElement("div");
      heading.className = "chart-tooltip-title";
      heading.textContent = `Stap ${col.dataset.step} · ${col.dataset.type}: ${col.dataset.title}`;
      tooltip.replaceChildren(
        heading,
        line("bereikt", col.dataset.reached),
        line("afgehaakt", col.dataset.dropped),
        line("nog bezig", col.dataset.busy),
      );
      tooltip.hidden = false;

      // Plaatst de tooltip boven de kolom, binnen de randen van het diagram.
      const chartBox = chart.getBoundingClientRect();
      const colBox = col.getBoundingClientRect();
      const left = colBox.left - chartBox.left + colBox.width / 2;
      const max = chartBox.width - tooltip.offsetWidth / 2 - 8;
      tooltip.style.left = `${Math.max(tooltip.offsetWidth / 2 + 8, Math.min(left, max))}px`;
    };
    const hide = () => {
      tooltip.hidden = true;
    };

    chart.querySelectorAll(".chart-col").forEach((col) => {
      col.addEventListener("pointerenter", () => show(col));
      col.addEventListener("focus", () => show(col));
      col.addEventListener("pointerleave", hide);
      col.addEventListener("blur", hide);
    });
  });
