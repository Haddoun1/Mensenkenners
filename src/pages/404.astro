---
import MainLayout from "../layouts/Layout.astro";

Astro.response.status = 404;
---

<MainLayout title="Pagina niet gevonden">
  <section class="not-found">
    <div class="not-found-card">
      <p class="not-found-code">404</p>
      <h1>Pagina niet gevonden</h1>
      <p class="not-found-text">
        Oeps! De pagina die je zoekt bestaat niet of is verplaatst.
      </p>
      <div class="not-found-actions">
        <a href="/" class="btn-primary">Terug naar home</a>
        <button type="button" class="btn-secondary" id="back-btn">Ga terug</button>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  document.getElementById("back-btn")?.addEventListener("click", () => {
    if (history.length > 1) {
      history.back();
    } else {
      window.location.href = "/";
    }
  });
</script>

<style>
  .not-found {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
    padding: 2rem 1.5rem 4rem;
  }

  .not-found-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 520px;
    width: 100%;
    padding: 2.5rem 1.75rem;
    text-align: center;
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    border-radius: 20px;
  }

  .not-found-code {
    font-family: var(--font-extra-bold);
    font-size: var(--size-8xl);
    line-height: 1;
    color: var(--color-cyan-dark);
  }

  :global(html.dark-mode) .not-found-code {
    color: #6ecfab;
  }

  .not-found-card h1 {
    font-size: var(--size-2xl);
    font-family: var(--font-bold);
    color: var(--color-text);
  }

  .not-found-text {
    font-family: var(--font-light);
    color: var(--color-text-muted);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn-primary,
  .btn-secondary {
    padding: 0.6rem 1.5rem;
    border-radius: 9999px;
    font-family: var(--font-bold);
    font-size: var(--size-sm);
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-primary {
    border: none;
    background: var(--color-cyan-dark);
    color: var(--color-background);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-green) 50%, transparent);
  }

  .btn-secondary {
    border: 1.5px solid color-mix(in srgb, var(--color-text) 15%, transparent);
    background: var(--button-background);
    color: var(--color-text);
  }

  .btn-secondary:hover {
    transform: translateY(-1px);
  }

  @media (min-width: 768px) {
    .not-found-code {
      font-size: var(--size-10xl);
    }
  }
</style>
