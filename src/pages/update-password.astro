---
import MainLayout from "../layouts/Layout-onboarding.astro";
import ThemeLogo from "../components/ThemeLogo.astro";

export const prerender = false;
---

<!-- Hier komt de link uit de resetmail op uit (via "Wachtwoord vergeten" of het adminpaneel). -->
<MainLayout
  title="Nieuw wachtwoord"
  nextHref="/"
  backHref="/onboarding/login"
  headingText=""
  bodyText=""
  step={1}
  totalSteps={5}
  showProgress={false}
  showBack={false}
  showNext={false}
  mockupSrc="/images/Mensenkennerskaderdoof.webp"
  mockupAlt="Vrouw maakt een handgebaar"
  showDashboardButton={false}
  variant="login"
>
  <div class="logo-container-theme">
    <ThemeLogo class="logo-image" />
  </div>

  <form class="login-form" id="reset-password-form">
    <fieldset>
      <div class="title-login">
        <legend>Nieuw wachtwoord</legend>
        <p>Kies een nieuw wachtwoord voor je account.</p>
      </div>

      <div class="container-name">
        <label for="new-password">
          Nieuw wachtwoord
          <input type="password" id="new-password" autocomplete="new-password" required />
        </label>
        <label for="confirm-password">
          Bevestig wachtwoord
          <input type="password" id="confirm-password" autocomplete="new-password" required />
        </label>
      </div>

      <div class="login-status" id="reset-status" role="alert" hidden>
        <p id="reset-status-text"></p>
        <a class="login-resend" id="reset-new-link" href="/onboarding/wachtwoord-vergeten" hidden>
          Vraag een nieuwe link aan
        </a>
      </div>
    </fieldset>

    <div class="buttons-onboarding">
      <a class="button-back" href="/onboarding/login">
        <span class="onboarding-btn">Terug naar inloggen</span>
      </a>
      <button type="submit" id="reset-submit">Wachtwoord opslaan</button>
    </div>
  </form>
</MainLayout>

<style>
  .logo-image {
    height: 40px;
    width: 160px;
    object-fit: contain;
    object-position: left;
  }
</style>

<script>
  // @ts-nocheck
  import { supabase } from "../lib/supabase";
  import { attachPasswordRules, isStrongPassword } from "../lib/passwordRules";

  const form = document.getElementById("reset-password-form");
  const submitBtn = document.getElementById("reset-submit");
  const status = document.getElementById("reset-status");
  const statusText = document.getElementById("reset-status-text");
  const newLink = document.getElementById("reset-new-link");
  attachPasswordRules(document.getElementById("new-password"));

  function showStatus(message, { type = "error", showNewLink = false } = {}) {
    statusText.textContent = message;
    status.classList.toggle("is-error", type === "error");
    status.classList.toggle("is-success", type === "success");
    newLink.hidden = !showNewLink;
    status.hidden = false;
  }

  // Supabase logt de gebruiker via de link in de mail tijdelijk in. Zonder geldige link kan het niet.
  const hashParams = new URLSearchParams(window.location.hash.slice(1));
  const {
    data: { session },
  } = await supabase.auth.getSession();

  if (hashParams.get("error") || !session) {
    submitBtn.disabled = true;
    showStatus(
      hashParams.get("error")
        ? "Deze link is verlopen of al gebruikt."
        : "Open deze pagina via de link in de mail om je wachtwoord te wijzigen.",
      { showNewLink: true },
    );
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const newPassword = document.getElementById("new-password").value;
    const confirmPassword = document.getElementById("confirm-password").value;

    if (!isStrongPassword(newPassword)) {
      showStatus("Je nieuwe wachtwoord voldoet nog niet aan alle eisen.");
      return;
    }

    if (newPassword !== confirmPassword) {
      showStatus("De wachtwoorden komen niet overeen.");
      return;
    }

    submitBtn.disabled = true;
    const { error } = await supabase.auth.updateUser({ password: newPassword });

    if (error) {
      submitBtn.disabled = false;
      showStatus("Opslaan lukte niet: " + error.message);
      return;
    }

    // Na het wijzigen ben je ingelogd; door naar het dashboard.
    showStatus("Je wachtwoord is gewijzigd. Je gaat zo naar het dashboard.", { type: "success" });
    setTimeout(() => {
      window.location.href = "/";
    }, 2000);
  });
</script>

