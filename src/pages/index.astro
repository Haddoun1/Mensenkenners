---
// @ts-nocheck
export const prerender = false;
import MainLayout from "../layouts/Layout.astro";
import CourseCard from "../components/CourseCard.astro";
import { courses } from "../data/courses.js";
---

<!-- DASHBOARD -->
<MainLayout>
  <section class="dashboard">
    <div class="dashboard-left">
      <div class="dashboard-title">
        <h1 id="welcome"></h1>
        <!-- WELCOME tekst injected by JS -->
        <hr />
      </div>
      <div class="dashboard-cursus">
        <h2>Mijn Cursussen</h2>
        <div class="dashboard-buttons">
          <button class="filter-button active" id="all-courses"
            >Alle cursussen</button
          >
          <hr />
          <button class="filter-button" id="not-started">Niet begonnen</button>
          <!-- Filters -->
          <button class="filter-button" id="in-progress">Bezig</button>
          <button class="filter-button" id="completed">Voltooid</button>
        </div>

        <!-- COURSES Cards -->
        <div class="carousel-wrapper">
          <ul class="carousel">
            {
              courses.map((course) => (
                <li class="carousel-item" data-course-id={course.id}>
                  <CourseCard
                    title={course.title}
                    description={course.description}
                    image={course.image}
                    progress={course.progress}
                    href={course.href}
                    color={course.color}
                    duration={course.duration}
                  />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- COURSE Details -->
  <aside class="course-detail" id="course-detail" tabindex="-1">
      <div class="detail-image">
        <div class="detail-image-placeholder"></div>
      </div>
      <div class="detail-content">
        <h3 id="detail-title"></h3>
        <p class="detail-progress" id="detail-progress"></p>
        <p class="detail-description" id="detail-description"></p>
        <div class="detail-actions">
          <a href="#" class="detail-cta" id="detail-cta"
            >Ga verder met deze cursus</a
          >
          <!-- Alleen zichtbaar bij een afgeronde cursus: terugkijken zonder antwoorden te wissen. -->
          <a href="#" class="detail-cta detail-cta--secondary" id="detail-review" hidden
            >Bekijk je antwoorden</a
          >
        </div>
      </div>
    </aside>

    <!-- Keuzevenster op telefoon en tablet bij een afgeronde cursus (daar is geen detailpaneel). -->
    <dialog class="course-dialog" id="course-dialog" aria-labelledby="course-dialog-title">
      <h2 id="course-dialog-title"></h2>
      <p>Je hebt deze cursus afgerond. Wil je opnieuw beginnen of je antwoorden terugkijken?</p>
      <div class="detail-actions">
        <a href="#" class="detail-cta" id="dialog-restart">Start deze cursus opnieuw</a>
        <a href="#" class="detail-cta detail-cta--secondary" id="dialog-review">Bekijk je antwoorden</a>
        <button type="button" class="course-dialog-close" id="dialog-close">Annuleren</button>
      </div>
    </dialog>
  </section>
</MainLayout>

<script>
  // @ts-nocheck
  import { supabase } from "../lib/supabase";
  import { totals, courseStartHref, categoryToCourseId } from "../data/courses.js";

  // Get user data for progress

  const {
    data: { user },
  } = await supabase.auth.getUser();

  function getResumeHref(courseId, latestRow, percentage) {
    // De onboarding begint altijd bij de welkomstpagina.
    if (courseId === "onboarding") {
      return courseStartHref.onboarding;
    }

    // Als de cursus al afgerond is, mag de gebruiker opnieuw starten bij stap 1.
    if (percentage >= 100) {
      return courseStartHref[courseId] || "/";
    }

    // Gebruik de opgeslagen URL, bijvoorbeeld /module-2/4.
    if (latestRow?.current_url) {
      return latestRow.current_url;
    }

    // Fallback als er nog geen progress of current_url is.
    return courseStartHref[courseId] || "/";
  }

  async function loadProgress() {
    if (!user) return;

    const response = await fetch("/api/get-progress", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ userId: user.id }),
    });

    const result = await response.json();
    const rows = result.data || [];

    const completed = {
      module_1: new Set(),
      module_2: new Set(),
      module_3: new Set(),
      module_4: new Set(),
      onboarding: new Set(),
    };

    const latestByCourse = {};

    rows.forEach((row) => {
      const courseId = categoryToCourseId[row.category];
      if (!courseId || !completed[courseId]) return;

      completed[courseId].add(String(row.step_id));

      const currentLatest = latestByCourse[courseId];
      const rowTime = new Date(
        row.ended_at || row.started_at || row.created_at || 0,
      ).getTime();
      const latestTime = currentLatest
        ? new Date(
            currentLatest.ended_at ||
              currentLatest.started_at ||
              currentLatest.created_at ||
              0,
          ).getTime()
        : -1;

      if (!currentLatest || rowTime > latestTime) {
        latestByCourse[courseId] = row;
      }
    });

    Object.keys(completed).forEach((key) => {
      const count = completed[key].size;
      const total = totals[key];
      const percentage = Math.min(100, Math.round((count / total) * 100));

      const card = document.querySelector(`[data-course-id="${key}"]`);
      if (!card) return;

      const progressText = card.querySelector("[data-progress-text]");
      const progressBar = card.querySelector("[data-progress-bar]");

      if (progressText) progressText.textContent = `${percentage}%`;
      if (progressBar) progressBar.value = percentage;

      let status = "not-started";
      if (count > 0 && count < total) status = "in-progress";
      if (count >= total) status = "completed";

      card.dataset.status = status;
      card.dataset.progress = String(percentage);

      const latestRow = latestByCourse[key];
      const resumeHref = getResumeHref(key, latestRow, percentage);
      card.dataset.resumeHref = resumeHref;
    });
  }

  await loadProgress();

  // Filters
  const filterButtons = document.querySelectorAll(".filter-button");
  const carouselItems = document.querySelectorAll(".carousel-item");

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const filter = btn.id;

      carouselItems.forEach((item) => {
        const status = item.dataset.status || "not-started";
        item.style.display =
          filter === "all-courses" || status === filter ? "" : "none";
      });
    });
  });

  // WELCOME tekst JS
  const hour = new Date().getHours();
  const greeting =
    hour < 12 ? "Goedemorgen" : hour < 18 ? "Goedemiddag" : "Goedenavond";

  const userName = user?.user_metadata?.name || "";
  const capitalizedUsername =
    userName.charAt(0).toUpperCase() + userName.slice(1);

  if (user) {
    document.getElementById("welcome").innerText =
      `${greeting}, ${capitalizedUsername}! Ga verder waar je gebleven was.`;
  } else {
    document.getElementById("welcome").innerText = `${greeting}!`;
  }

  // Course informatie details
  const courseData = {
    onboarding: {
      title: "Onboarding",
      href: "/onboarding/welkom-no-loader",
      description:
        "Welkom bij de onboarding! In deze cursus maken we je wegwijs in het platform en leggen we uit wat je kunt verwachten in de verschillende delen van de cursus.",
      image: "/images/mockupmensenkenners.webp",
      color: "var(--color-green)",
    },
    module_1: {
      title: "Module 1: Inclusief Contact",
      href: "/module-1/1",
      description:
        "In deze module oefen je met basisprincipes die in veel situaties toepasbaar zijn.",
      image: "/images/Mensenkennerskaderdoof.webp",
      color: "var(--color-pink)",
    },
    module_2: {
      title: "Module 2: Perspectief en inlevingsvermogen",
      href: "/module-2/1",
      description:
        "In deze module sta je stil bij situaties waarin bezoekers de wereld anders ervaren.",
      image: "/images/Mensenkennerskaderroller.webp",
      color: "var(--color-yellow)",
    },
    module_3: {
      title: "Toegankelijkheid van jouw werkplek",
      href: "/module-3/1",
      description:
        "In deze module ga je leren hoe je jouw werplek concreet inclusief kunt maken.",
      image: "/images/Mensenkennerskaderspraak.webp",
      color: "var(--color-red)",
    },
    module_4: {
      title: "Module 4: Praktijksituaties en toepassing",
      href: "/module-4/1",
      description: "In deze module oefen je met herkenbare situaties.",
      image: "/images/Mensenkennerskaderspraak.webp",
      color: "var(--color-blue)",
    },
  };

  const detail = document.getElementById("course-detail");

  // Wist de antwoorden van een module in Supabase (tabel course_answers, zie "Antwoorden bewaren"
  // in [step].astro), zodat de vragen leeg zijn als iemand een afgeronde cursus opnieuw start.
  async function clearCourseAnswers(courseId) {
    const category = Object.keys(categoryToCourseId).find(
      (slug) => categoryToCourseId[slug] === courseId,
    );
    if (!category || !user) return;

    const { error } = await supabase
      .from("course_answers")
      .delete()
      .eq("user_id", user.id)
      .eq("category", category);

    if (error) console.error("Antwoorden wissen mislukt:", error.message);

    // Zet de voortgang terug naar 0%: een reset-rij zorgt ervoor dat get-progress
    // alleen stappen ná dit moment meetelt.
    const now = new Date().toISOString();
    await fetch("/api/track-step", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        userId: user.id,
        email: user.email || null,
        name: user.user_metadata?.name || null,
        stepId: "reset",
        category,
        currentUrl: null,
        startedAt: now,
        endedAt: now,
        durationSeconds: 0,
      }),
    }).catch((err) => console.error("Voortgang resetten mislukt:", err));
  }

  // Wist eerst de antwoorden en gaat daarna pas naar de cursus,
  // anders kan de eerste vraag nog de oude antwoorden laden.
  async function restartCourse(e, courseId) {
    e.preventDefault();
    const href = e.currentTarget.getAttribute("href");
    await clearCourseAnswers(courseId);
    window.location.href = href;
  }

  // Opnieuw starten van een afgeronde cursus via de knop in het detailpaneel.
  document.getElementById("detail-cta")?.addEventListener("click", (e) => {
    const cta = e.currentTarget;
    if (cta.dataset.status === "completed") restartCourse(e, cta.dataset.courseId);
  });

  // Een afgeronde module kun je opnieuw doen of terugkijken. De onboarding bewaart geen antwoorden,
  // dus daar is terugkijken niet nodig.
  const canReview = (courseId, status) => status === "completed" && courseId !== "onboarding";

  // Keuzevenster voor telefoon en tablet.
  const courseDialog = document.getElementById("course-dialog");
  const dialogRestart = document.getElementById("dialog-restart");
  const dialogReview = document.getElementById("dialog-review");

  dialogRestart?.addEventListener("click", (e) => restartCourse(e, dialogRestart.dataset.courseId));
  document.getElementById("dialog-close")?.addEventListener("click", () => courseDialog.close());

  document.querySelectorAll(".carousel-item").forEach((item) => {
    item.addEventListener("click", (e) => {
      e.preventDefault();
      // Op telefoon en tablet direct naar de cursus, zonder detailpaneel.
      if (window.matchMedia("(max-width: 1023px)").matches) {
        const courseId = item.dataset.courseId;
        const href = item.dataset.resumeHref || courseData[courseId]?.href;

        // Afgeronde module: laat kiezen tussen opnieuw starten en terugkijken.
        if (canReview(courseId, item.dataset.status) && courseDialog) {
          document.getElementById("course-dialog-title").textContent = courseData[courseId]?.title || "";
          dialogRestart.href = href;
          dialogRestart.dataset.courseId = courseId;
          dialogReview.href = href;
          courseDialog.showModal();
          return;
        }

        if (href) window.location.href = href;
        return;
      }

      const courseId = item.dataset.courseId;
      const data = courseData[courseId];
      if (!data) return;

      if (
        detail.classList.contains("active") &&
        detail.dataset.openCourse === courseId
      ) {
        detail.classList.remove("active");
        detail.dataset.openCourse = "";
        return;
      }

      detail.dataset.openCourse = courseId;

      const resumeHref = item.dataset.resumeHref || data.href;
      const status = item.dataset.status || "not-started";

      document.getElementById("detail-title").textContent = data.title;
      document.getElementById("detail-description").textContent =
        data.description;

      const cta = document.getElementById("detail-cta");
      cta.href = resumeHref;
      cta.dataset.status = status;
      cta.dataset.courseId = courseId;
      cta.textContent =
        status === "completed"
          ? "Start deze cursus opnieuw"
          : status === "in-progress"
            ? "Ga verder waar je gebleven was"
            : "Start deze cursus";

      cta.style.setProperty("background-color", data.color);

      const review = document.getElementById("detail-review");
      review.hidden = !canReview(courseId, status);
      review.href = resumeHref;
      review.style.setProperty("border-color", data.color);
      document
        .getElementById("detail-progress")
        .style.setProperty("color", data.color);

      const placeholder = document.querySelector(".detail-image-placeholder");
      placeholder.style.backgroundImage = `url('${data.image}')`;
      placeholder.style.backgroundSize = "cover";
      placeholder.style.backgroundPosition = "center";

      const progressText =
        item.querySelector("[data-progress-text]")?.textContent || "0%";
      document.getElementById("detail-progress").textContent =
        progressText + " compleet";

      detail.classList.add("active");

detail.setAttribute("tabindex", "-1");
detail.focus();
    });
  });
</script>

<style>
  /* DASHBOARD */
  .dashboard {
    margin: 0 auto;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: start;
  }

  .dashboard-left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
    flex: 1;
    width: 100%;
  }

  .dashboard-title {
    display: flex;
    flex-direction: column;
    gap: var(--size-sm);

    & hr {
      border: 2px solid var(--color-green);
      width: 200px;
    }
  }

  .dashboard-cursus {
    display: flex;
    flex-direction: column;
    gap: var(--size-sm);

    .dashboard-buttons {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;

      & .filter-button {
        padding: 0.5rem 1rem;
        border: 2px solid var(--color-green);
        background-color: var(--button-background);
        color: var(--color-green);
        border-radius: 9999px;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        font-family: var(--font-bold);

        &:hover {
          background-color: var(--color-green);
          color: var(--color-background);
          background: var(--color-cyan-dark);
          border-color: color-mix(in srgb, var(--color-green) 80%, black);
          transform: translateY(-1px);
          box-shadow: 0 4px 14px
            color-mix(in srgb, var(--color-green) 50%, transparent);
        }

        &.active {
          background-color: var(--color-green);
          color: var(--color-background);
        }
      }
    }
  }

  .dashboard-cursus hr {
    border: 1.6px solid var(--color-green);
  }

  h1,
  h2 {
    font-size: var(--size-2xl);
    color: var(--color-text);
  }

  .carousel-wrapper {
    margin-top: 1rem;
  }

  .carousel {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .carousel-item {
    min-width: 0;
    display: flex;
  }

  /* ASIDE/DETAIL */
  .course-detail {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--gradient-bg-cyan-card);
    border-radius: 12px;
    width: 100%;
    opacity: 0;
    overflow: hidden;
    height: 0;
    padding: 0;
    transition:
      height 0.4s ease,
      opacity 0.4s ease,
      padding 0.4s ease;
  }

  .course-detail.active {
    opacity: 1;
    height: auto;
    padding: 1.5rem;
    margin-left: 2rem;
  }

  .detail-image {
    width: 100%;
    border-radius: 8px;
    height: 200px;
    overflow: hidden;
  }

  .detail-image-placeholder {
    width: 100%;
    height: 200px;
    background-size: cover;
    background-position: center;
  }

  .detail-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .detail-content h3 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--color-text);
  }

  .detail-progress {
    font-size: 0.9rem;
    margin: 0;
    font-family: var(--font-bold);
  }

  .detail-description {
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-medium);
  }

  .detail-actions {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .detail-cta {
    display: block;
    text-align: center;
    padding: 0.75rem;
    background: var(--color-green);
    color: var(--color-text);
    border-radius: 9999px;
    text-decoration: none;
    font-family: var(--font-bold);
    font-size: 0.95rem;
    transition: all 0.3s ease;

    &:hover {
      background-color: color-mix(in srgb, var(--color-green) 85%, black);
      scale: 1.02;
    }
  }

  html.dark-mode .detail-cta:hover {
    background-color: color-mix(in srgb, var(--color-green) 85%, white);
  }

  .detail-cta[hidden] {
    display: none;
  }

  /* Tweede knop: zelfde vorm, alleen een rand, zodat "opnieuw starten" de hoofdknop blijft. */
  .detail-cta.detail-cta--secondary {
    background: transparent;
    border: 2px solid var(--color-green);
    padding: calc(0.75rem - 2px);

    &:hover {
      background: color-mix(in srgb, var(--color-text) 6%, transparent);
    }
  }

  html.dark-mode .detail-cta.detail-cta--secondary:hover {
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
  }

  /* Keuzevenster op telefoon en tablet. */
  .course-dialog {
    width: min(100% - 2rem, 26rem);
    border: none;
    border-radius: 12px;
    padding: 1.5rem;
    /* De kaartachtergrond is in dark mode een doorzichtig verloop, dus eronder een effen kleur.
       In light mode is de variabele een kleur; dan wordt background-image genegeerd en blijft de effen kleur. */
    background-color: var(--color-surface);
    background-image: var(--gradient-bg-cyan-card);
    color: var(--color-text);
  }

  .course-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .course-dialog h2 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
  }

  .course-dialog p {
    margin: 0 0 1.25rem;
    font-family: var(--font-medium);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .course-dialog-close {
    background: none;
    border: none;
    padding: 0.5rem;
    color: var(--color-text);
    font-family: var(--font-bold);
    font-size: 0.95rem;
    text-decoration: underline;
    cursor: pointer;
  }

  /* MEDIA */

  @media (min-width: 768px) {
    h1 {
      font-size: var(--size-3xl);
    }

    h2 {
      font-size: var(--size-2xl);
    }
  }

  @media (min-width: 768px) {
    .dashboard {
      flex-direction: row;
      align-items: start;
    }
  }

  @media (min-width: 768px) {
    .carousel {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .dashboard:has(.course-detail.active) .carousel {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 768px) {
    .course-detail {
      width: 0;
      min-width: 0;
      height: 82vh;
      position: sticky;
      top: 5rem;
      transform: translateX(100%);
      transition:
        width 0.4s ease,
        opacity 0.4s ease,
        transform 0.4s ease,
        padding 0.4s ease;
    }
  }

  @media (min-width: 768px) {
    .course-detail.active {
      width: 320px;
      min-width: 320px;
      height: 82vh;
      transform: translateX(0);
      padding: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .carousel {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .dashboard:has(.course-detail.active) .carousel {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1440px) {
    .dashboard:has(.course-detail.active) .carousel {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Detailpaneel verbergen op telefoon en tablet */
  @media (max-width: 1023px) {
    .course-detail,
    .course-detail.active {
      display: none !important;
    }
  }
</style>

