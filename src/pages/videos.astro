---
// Alle video's, per onderwerp. Bereikbaar via de videokaart op het dashboard.
// De video's uit de modules zelf, plus de lijst aan het eind van module 4 (m4_submit in
// mensenkennersvragen.json); zie src/lib/videos.js.
// Zelfde opbouw en stijl als de cursuspagina's ([category]/[step].astro): Dashboard-knop, kaart, achtergrond.
import BaseHead from "../components/BaseHead.astro";
import FixedThemeToggle from "../components/FixedThemeToggle.astro";
import { allVideos, videoCategoriesOf } from "../lib/videos";

const videoCategories = videoCategoriesOf(allVideos);
---

<html lang="nl">
  <head>
    <BaseHead title="Video's" />
  </head>
  <body>
    <FixedThemeToggle />

    <!-- Lichtgroen, net als de videokaart op het dashboard. -->
    <div class="page-shell" style="--color-accent: var(--accent-intro)">
      <aside class="sidebar-left" aria-hidden="true"></aside>

      <main class="content-col">
        <header class="page-header">
          <a href="/" class="back-button header-btn">Dashboard</a>
        </header>

        <section class="card">
          <h1 class="card-title">Video's</h1>
          <p class="card-body">
            Korte video's over de omgang met verschillende beperkingen. Kies een onderwerp om alleen die
            video's te zien.
          </p>

          <!-- Onderwerpen: kies er één om alleen die video's te tonen. -->
          <div class="video-filter" role="group" aria-label="Kies een onderwerp">
            <button type="button" class="video-filter-btn" data-video-filter="" aria-pressed="true">
              Alle video's
            </button>
            {videoCategories.map((videoCategory) => (
              <button type="button" class="video-filter-btn" data-video-filter={videoCategory} aria-pressed="false">
                {videoCategory}
              </button>
            ))}
          </div>

          <p class="video-count" data-video-count aria-live="polite">{allVideos.length} video's</p>

          <ul class="video-grid">
            {allVideos.map((video) => (
              <li class="video-tile" data-video-category={video.category || ""}>
                <div class="video-wrapper">
                  {video.platform ? (
                    <a class="video-external" href={video.url} target="_blank" rel="noopener noreferrer">
                      <span class="video-external-play" aria-hidden="true">▶</span>
                      <span>Bekijk deze video op {video.platform}</span>
                      <span class="video-external-note">Opent in een nieuw tabblad</span>
                    </a>
                  ) : (
                    <iframe
                      src={video.embedUrl}
                      title={video.title}
                      loading="lazy"
                      allow="autoplay; fullscreen; picture-in-picture"
                      allowfullscreen
                    />
                  )}
                </div>
                <div class="video-caption">
                  {(video.label || video.category) && (
                    <span class="video-category">{video.label || video.category}</span>
                  )}
                  <span class="video-title">{video.title}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      </main>

      <aside class="sidebar-right" aria-hidden="true"></aside>
    </div>
  </body>
</html>

<script>
  // @ts-nocheck
  import { limitVideoEnds } from "../lib/videoLimit";

  // Video's met een eindtijd niet verder laten spelen dan dat einde (zie src/lib/videoLimit.js).
  limitVideoEnds();

  // Onderwerp kiezen: toont alleen die video's.
  const filterButtons = [...document.querySelectorAll("[data-video-filter]")];
  const tiles = [...document.querySelectorAll(".video-tile")];
  const count = document.querySelector("[data-video-count]");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const chosen = button.dataset.videoFilter;
      filterButtons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
      tiles.forEach((tile) => {
        tile.hidden = Boolean(chosen) && tile.dataset.videoCategory !== chosen;
      });
      const visible = tiles.filter((tile) => !tile.hidden).length;
      count.textContent = `${visible} ${visible === 1 ? "video" : "video's"}`;
    });
  });
</script>

<style>
  /* Achtergrond, layout, Dashboard-knop en kaart: overgenomen van [category]/[step].astro. */
  body {
    background: var(--gradient-bg-cyan);
    min-height: 100vh;
  }

  .header-btn {
    font-family: var(--font-semi-bold);
    font-size: var(--size-base);
    height: 2.65rem;
    padding: 0 1.4rem;
    background: color-mix(in srgb, var(--color-accent) 35%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 60%, transparent);
    border-radius: 999px;
    color: var(--color-text);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    transition: background 0.18s, transform 0.12s, box-shadow 0.18s;
    flex-shrink: 0;
  }

  .header-btn:hover {
    background: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 80%, black);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-accent) 50%, transparent);
  }

  .header-btn:active {
    transform: scale(0.97);
  }

  :global(html.dark-mode) .header-btn {
    background: color-mix(in srgb, var(--color-accent) 80%, var(--color-surface));
    border-color: color-mix(in srgb, var(--color-accent) 40%, #ffffff);
  }

  :global(html.dark-mode) .header-btn:hover {
    background: color-mix(in srgb, var(--color-accent) 85%, #ffffff);
    border-color: color-mix(in srgb, var(--color-accent) 25%, #ffffff);
  }

  .back-button::before {
    content: "←";
    font-size: var(--size-lg);
    transition: transform 0.2s;
    margin-top: -2px;
  }

  .back-button:hover::before {
    transform: translateX(-2px);
  }

  .page-shell {
    display: grid;
    grid-template-columns: 1fr 4fr 1fr;
    min-height: 100vh;
    max-width: 1200px;
    margin-inline: auto;
    padding: 0 1rem;
    gap: 0 2rem;
  }

  .content-col {
    min-width: 0;
    padding: 5rem 0 7rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .card {
    background: var(--module-card-background);
    backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
    border-radius: 20px;
    padding: 2.5rem 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--color-text);
  }

  .card-title {
    font-family: var(--font-extra-bold);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.15;
    margin: 0;
  }

  .card-body {
    font-family: var(--font-light);
    font-size: var(--size-lg);
    line-height: 1.65;
    margin: 0;
  }

  /* Onderwerpknoppen: zelfde stijl als bij de video's aan het eind van module 4. */
  .video-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .video-filter-btn {
    font-family: var(--font-semi-bold);
    font-size: var(--size-sm);
    color: var(--color-text);
    background: transparent;
    border: 1.5px solid color-mix(in srgb, var(--color-text) 45%, transparent);
    border-radius: 99px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
  }

  .video-filter-btn:hover {
    background: color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  .video-filter-btn[aria-pressed="true"] {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-text-inverse);
  }

  .video-count {
    margin: 0;
    font-family: var(--font-semi-bold);
    font-size: var(--size-sm);
  }

  .video-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1.5rem 1.25rem;
  }

  .video-tile {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .video-tile[hidden] {
    display: none;
  }

  /* Zelfde videokader als in de modules. */
  .video-wrapper {
    position: relative;
    padding-top: 56.25%;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-text) 10%, transparent);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-text) 12%, transparent);
  }

  .video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Kaart voor video's die niet in de pagina kunnen spelen (TikTok, Facebook). */
  .video-external {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 1rem;
    text-align: center;
    font-family: var(--font-semi-bold);
    color: var(--color-text);
    text-decoration: none;
    background: color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  .video-external:hover span:nth-child(2) {
    text-decoration: underline;
  }

  .video-external-play {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-text-inverse);
    font-size: 1.1rem;
  }

  .video-external-note {
    font-family: var(--font-light);
    font-size: var(--size-sm);
  }

  .video-caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .video-category {
    font-family: var(--font-semi-bold);
    font-size: var(--size-sm);
    color: var(--color-text-muted);
  }

  .video-title {
    font-family: var(--font-semi-bold);
    line-height: 1.35;
  }

  /* Telefoon: zelfde aanpassingen als de cursuspagina's. */
  @media (max-width: 600px) {
    .page-shell { grid-template-columns: 1fr; padding: 0 1rem; }
    .sidebar-left, .sidebar-right { display: none; }
    .content-col { padding: 3.5rem 0 7rem; }
    .card { padding: 1.5rem 1.25rem; border-radius: 14px; }
    .card-title { font-size: clamp(1.35rem, 6vw, 1.8rem); }

    .header-btn {
      font-size: var(--size-sm);
      height: 2.4rem;
      padding: 0 0.85rem;
      gap: 0.3rem;
    }
  }
</style>
